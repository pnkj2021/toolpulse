---
import { BRAND } from '../config/brand';

interface Props {
	showSubtitle?: boolean;
	class?: string;
}

const { showSubtitle = false, class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
	<svg class="size-9 shrink-0" viewBox="0 0 64 64" role="img" aria-label={`${BRAND.shortName} logo`}>
		<rect width="64" height="64" rx="16" fill={BRAND.primaryColor} />
		<text x="32" y="39" fill="white" font-family="Inter, ui-sans-serif, system-ui, sans-serif" font-size="21" font-weight="800" letter-spacing="-1.5" text-anchor="middle">YBS</text>
	</svg>
	<span class="min-w-0 leading-none">
		<strong class="block text-lg font-extrabold tracking-tight text-slate-950 dark:text-white">{BRAND.shortName}</strong>
		{showSubtitle && <small class="mt-1 block text-[0.65rem] font-medium tracking-wide text-slate-500 dark:text-slate-400">{BRAND.fullName}</small>}
	</span>
</span>
