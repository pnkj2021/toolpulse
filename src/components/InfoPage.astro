---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
	title: string;
	description: string;
	canonicalPath: string;
	eyebrow?: string;
}

const { title, description, canonicalPath, eyebrow = 'ToolPulse' } = Astro.props;
---

<BaseLayout title={`${title} | ToolPulse`} description={description} canonicalPath={canonicalPath}>
	<section class="page-container py-10 sm:py-14">
		<div class="mx-auto max-w-3xl">
			<p class="eyebrow">{eyebrow}</p>
			<h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950 dark:text-white sm:text-4xl">{title}</h1>
			<p class="mt-3 text-base leading-7 text-slate-600 dark:text-slate-300">{description}</p>
			<div class="content-card info-content mt-7">
				<slot />
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.info-content :global(h2) {
		margin-top: 1.75rem;
		font-size: 1.125rem;
		font-weight: 700;
	}
	.info-content :global(h2:first-child) { margin-top: 0; }
	.info-content :global(p),
	.info-content :global(ul) {
		margin-top: 0.75rem;
		color: rgb(71 85 105);
		font-size: 0.9375rem;
		line-height: 1.75;
	}
	.info-content :global(ul) { padding-left: 1.25rem; list-style: disc; }
	.info-content :global(a) { color: rgb(37 99 235); font-weight: 600; }
	.info-content :global(a:hover) { text-decoration: underline; }
	@media (prefers-color-scheme: dark) {
		.info-content :global(p),
		.info-content :global(ul) { color: rgb(203 213 225); }
	}
</style>
