<section class="rounded-2xl border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900" aria-label="Comparison controls">
	<div class="flex flex-wrap items-center gap-x-5 gap-y-3">
		<fieldset class="flex flex-wrap gap-x-4 gap-y-2">
			<legend class="sr-only">Comparison options</legend>
			{[
				['ignore-whitespace', 'Ignore whitespace'],
				['ignore-case', 'Ignore case'],
				['ignore-blank-lines', 'Ignore blank lines'],
				['ignore-line-endings', 'Ignore line endings'],
				['word-wrap', 'Word wrap'],
			].map(([id, label]) => (
				<label class="inline-flex cursor-pointer items-center gap-2 text-sm font-medium text-slate-700 dark:text-slate-200">
					<input id={id} type="checkbox" checked={id === 'ignore-line-endings'} class="size-4 rounded border-slate-300 text-blue-600 focus:ring-2 focus:ring-blue-500" />
					{label}
				</label>
			))}
		</fieldset>
	</div>
</section>
