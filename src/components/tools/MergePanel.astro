---
import CopyButton from '../CopyButton.astro';
import DownloadButton from '../DownloadButton.astro';
---

<section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900" aria-labelledby="merged-heading">
	<div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-4 py-3 dark:border-slate-700">
		<div>
			<h2 id="merged-heading" class="text-sm font-semibold text-slate-800 dark:text-slate-100">Merged result</h2>
			<p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">Updates immediately when you resolve a changed block.</p>
		</div>
		<div class="flex gap-2">
			<CopyButton id="copy-merged" targetId="merged-result" />
			<DownloadButton id="download-merged" label="Download TXT" />
			<button id="clear-merged" type="button" class="button-secondary">Clear</button>
		</div>
	</div>
	<textarea id="merged-result" class="block min-h-[260px] w-full resize-y bg-slate-50 p-4 font-mono text-sm leading-6 text-slate-800 outline-none focus:ring-4 focus:ring-inset focus:ring-blue-100 dark:bg-slate-950 dark:text-slate-100 dark:focus:ring-blue-900" readonly aria-label="Merged text result"></textarea>
	<p id="diff-live-status" class="sr-only" aria-live="polite"></p>
</section>
