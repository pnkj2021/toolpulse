---
import type { Tool } from '../../data/tools';
import { toolHref } from '../../data/tools';
import ToolIcon from './ToolIcon.astro';

interface Props { tools: readonly Tool[] }
const { tools } = Astro.props;
---

<div id="search-area" class="relative z-20 mx-auto max-w-[50rem]">
	<div class="group relative flex h-[3.25rem] items-center overflow-hidden rounded-[0.9375rem] border border-slate-200 bg-white shadow-[inset_0_1px_0_rgba(255,255,255,.75)] transition duration-200 hover:border-slate-300 focus-within:border-blue-600 focus-within:shadow-[0_0_0_3px_rgba(37,99,235,.10),inset_0_1px_0_rgba(255,255,255,.7)] dark:border-[#273449] dark:bg-[#111827] dark:shadow-[inset_0_1px_0_rgba(255,255,255,.04)] dark:hover:border-[#334155] dark:focus-within:border-blue-500 dark:focus-within:shadow-[0_0_0_3px_rgba(59,130,246,.10),inset_0_1px_0_rgba(255,255,255,.04)] sm:h-14">
		<svg class="pointer-events-none ml-4 size-5 shrink-0 text-slate-400 transition-colors duration-200 group-focus-within:text-blue-600 dark:text-slate-500 dark:group-focus-within:text-blue-400" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="m16 16 4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
		<label for="tool-search" class="sr-only">Search tools</label>
		<input id="tool-search" type="search" placeholder="Search tools by name or category..." autocomplete="off" aria-controls="search-suggestions search-result-count" aria-expanded="false" aria-keyshortcuts="/" class="min-w-0 flex-1 appearance-none bg-transparent px-3 text-sm text-slate-900 outline-none placeholder:text-slate-400 dark:text-slate-50 dark:placeholder:text-slate-500 sm:text-base" />
		<kbd id="search-shortcut" class="pointer-events-none mr-3 hidden rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 font-sans text-xs text-slate-400 dark:border-[#334155] dark:bg-[#0f172a] dark:text-slate-400 sm:inline-flex">/</kbd>
		<button id="clear-search" type="button" class="mr-2 grid size-9 shrink-0 place-items-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-blue-500/25 dark:hover:bg-[#172033] dark:hover:text-slate-100" aria-label="Clear search" hidden>
			<svg class="size-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
		</button>
	</div>
	<p id="search-result-count" class="sr-only" aria-live="polite">{tools.length} tools found</p>
	<div id="search-suggestions" class="absolute inset-x-0 top-14 mt-3 hidden overflow-hidden rounded-2xl border border-slate-200 bg-white p-2 text-left shadow-2xl" role="listbox" aria-label="Tool search results">
		<p class="px-3 py-2 text-xs font-bold uppercase tracking-wider text-slate-400">Quick results</p>
		{tools.map((tool) => <a href={toolHref(tool)} class="search-suggestion flex items-center gap-3 rounded-xl px-3 py-2.5 hover:bg-blue-50 focus:bg-blue-50 focus:outline-none" data-suggestion data-search={[tool.name, tool.description, tool.category, ...tool.tags].join(' ').toLowerCase()} data-categories={tool.tags.join(' ').toLowerCase()} role="option"><ToolIcon slug={tool.slug} size="sm" /><span class="min-w-0"><strong class="block text-sm text-slate-900">{tool.name}</strong><span class="block truncate text-xs text-slate-500">{tool.description}</span></span><span class="ml-auto shrink-0 text-xs font-medium text-slate-400">{tool.category}</span></a>)}
		<p id="no-suggestions" class="hidden px-3 py-5 text-center text-sm text-slate-500">No matching tools.</p>
	</div>
</div>
