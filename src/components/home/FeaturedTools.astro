---
import type { Tool } from '../../data/tools';
import { toolHref } from '../../data/tools';
import ToolIcon from './ToolIcon.astro';

interface Props { tools: readonly Tool[] }
const { tools } = Astro.props;
---

<section id="tools" class="scroll-mt-24 border-t border-slate-100 bg-slate-50 py-4 dark:bg-[#0b1120] sm:py-5" aria-labelledby="tools-heading">
	<div class="page-container">
		<div class="flex items-end justify-between gap-4">
			<div>
				<h2 id="tools-heading" class="text-2xl font-extrabold tracking-tight text-slate-950">Popular Tools</h2>
				<p class="mt-1 text-sm text-slate-500">Quick access to your most-used browser tools.</p>
			</div>
			<a href="#tool-grid" class="shrink-0 text-sm font-semibold text-blue-600 hover:text-blue-500 focus-visible:rounded-md focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-blue-500/20">View all tools <span aria-hidden="true">&rarr;</span></a>
		</div>
		<div id="tool-grid" class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
			{tools.map((tool) => (
				<a
					href={toolHref(tool)}
					class:list={[
						'group flex min-h-36 rounded-2xl border bg-white p-4 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-blue-500 hover:bg-gradient-to-br hover:from-white hover:to-blue-50/60 hover:shadow-lg hover:shadow-slate-900/10 focus-visible:-translate-y-0.5 focus-visible:border-blue-500 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-blue-500/20 dark:bg-[#111827] dark:hover:bg-none dark:hover:bg-[#172033] dark:hover:shadow-black/25',
						tool.slug === 'diff-checker' ? 'border-blue-400/80 dark:border-blue-500/70' : 'border-slate-200 dark:border-[#273449]',
					]}
					data-tool-card
					data-search={[tool.name, tool.description, tool.category, ...tool.tags].join(' ').toLowerCase()}
					data-categories={tool.tags.join(' ').toLowerCase()}
					aria-label={`Open ${tool.name}`}
				>
					<ToolIcon slug={tool.slug} size="card" />
					<div class="ml-3 flex min-w-0 flex-1 flex-col">
						<h3 class="line-clamp-2 text-sm font-bold leading-5 text-slate-950">{tool.name}</h3>
						<p class="mt-1 line-clamp-2 text-xs leading-5 text-slate-500">{tool.description}</p>
						<span class="mt-auto w-fit rounded-md border border-slate-200 bg-slate-50 px-2 py-1 text-[0.65rem] text-slate-500 dark:border-[#273449] dark:bg-[#172033]">{tool.category}</span>
					</div>
					<span class="ml-2 mt-auto grid size-8 shrink-0 place-items-center self-end rounded-full border border-slate-200 text-sm text-slate-500 transition duration-200 group-hover:translate-x-0.5 group-hover:border-blue-500 group-hover:bg-blue-600 group-hover:text-white group-focus-visible:border-blue-500 group-focus-visible:bg-blue-600 group-focus-visible:text-white dark:border-[#334155]" aria-hidden="true">&rarr;</span>
				</a>
			))}
		</div>
		<div id="no-results" class="mt-10 hidden rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center"><p class="font-bold text-slate-700">No tools found</p><p class="mt-1 text-sm text-slate-500">Try a different search or category.</p></div>
	</div>
</section>
