---
import Logo from './Logo.astro';
import { BRAND } from '../config/brand';
---

<footer class="border-t border-slate-200 bg-white">
	<div class="page-container py-12">
		<div class="grid gap-10 sm:grid-cols-[1fr_auto] sm:items-start">
			<div class="max-w-sm">
				<a href="/" aria-label={`${BRAND.shortName} home`}><Logo /></a>
				<p class="mt-4 text-sm leading-6 text-slate-500 dark:text-slate-400">Everything you need.<br/>Right in your browser.</p>
			</div>
			<div><h2 class="text-xs font-bold uppercase tracking-[0.15em] text-slate-900">Quick Links</h2><nav aria-label="Footer navigation" class="mt-4 grid grid-cols-2 gap-x-8 gap-y-3 text-sm font-medium text-slate-500"><a href="/#tools" class="hover:text-blue-600">Tools</a><a href="/privacy/" class="hover:text-blue-600">Privacy</a><a href="/contact/" class="hover:text-blue-600">Contact</a><a href="https://github.com/" class="hover:text-blue-600" rel="noopener noreferrer">GitHub</a></nav></div>
		</div>
		<p class="mt-6 border-t border-slate-100 pt-5 text-xs text-slate-400 dark:border-slate-800 dark:text-slate-500">&copy; {new Date().getFullYear()} {BRAND.shortName} — {BRAND.fullName}. All rights reserved.</p>
	</div>
</footer>
