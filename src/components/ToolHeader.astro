---
interface Props {
	title: string;
	description: string;
	category?: string;
}

const { title, description, category = 'Developer tool' } = Astro.props;
---

<header class="mb-6">
	<p class="eyebrow">{category}</p>
	<h1 class="mt-1 text-3xl font-extrabold tracking-tight text-slate-950 dark:text-white sm:text-4xl">{title}</h1>
	<p class="mt-2 max-w-3xl leading-7 text-slate-600 dark:text-slate-300">{description}</p>
</header>
