---
interface Props {
	id: string;
	label?: string;
}

const { id, label = 'Choose a file or drag it here' } = Astro.props;
---

<label for={id} data-drop-zone class="group flex min-h-40 cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 px-5 py-7 text-center transition hover:border-blue-400 hover:bg-blue-50 focus-within:border-blue-500 focus-within:ring-4 focus-within:ring-blue-100 dark:border-slate-600 dark:bg-slate-800 dark:hover:border-blue-500">
	<span class="grid size-11 place-items-center rounded-xl bg-white text-blue-600 shadow-sm dark:bg-slate-700" aria-hidden="true">
		<svg class="size-5" viewBox="0 0 24 24" fill="none"><path d="M12 16V4m0 0L8 8m4-4 4 4M5 14v5h14v-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
	</span>
	<strong class="mt-3 text-sm text-slate-800 dark:text-slate-100">{label}</strong>
	<span class="mt-1 text-xs text-slate-500 dark:text-slate-400">Any file type is supported</span>
	<input id={id} type="file" class="sr-only" aria-label={label} />
</label>
