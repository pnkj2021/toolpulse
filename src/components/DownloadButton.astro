---
interface Props {
	id: string;
	label?: string;
	disabled?: boolean;
}

const { id, label = 'Download', disabled = true } = Astro.props;
---

<button id={id} type="button" class="button-secondary" disabled={disabled}>
	<svg class="size-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 20h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
	{label}
</button>
