---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolLayout from '../../components/ToolLayout.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import DiffEditor from '../../components/tools/DiffEditor.astro';
import DiffToolbar from '../../components/tools/DiffToolbar.astro';
import DiffSummary from '../../components/tools/DiffSummary.astro';
import DiffViewer from '../../components/tools/DiffViewer.astro';

const pageTitle = 'Diff Checker - Compare Text & Code Online | YBS';
const pageDescription = 'Compare text or code side by side, find line-by-line differences, and merge changes with YBS Diff Checker. Free, private, and browser-based.';
const webApplicationSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: 'YBS Diff Checker',
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'Any',
	description: pageDescription,
	...(Astro.site ? { url: new URL('/tools/diff-checker', Astro.site).href } : {}),
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	featureList: ['Side-by-side text and code comparison', 'Line-based and inline differences', 'Per-block merge controls', 'Private browser processing'],
};
const faqItems = [
	{
		question: 'What is a diff checker?',
		answer: 'A diff checker compares two versions of text and identifies content that was added, removed, or changed.',
	},
	{
		question: 'Can I compare source code with this tool?',
		answer: 'Yes. The editors accept plain text, including source code, JSON, SQL, configuration files, and documentation.',
	},
	{
		question: 'Can I merge differences?',
		answer: 'Yes. For each changed block, you can copy the original version to the modified editor or copy the modified version back to the original editor.',
	},
	{
		question: 'Does YBS upload my text or code?',
		answer: 'No. The comparison runs in your browser, and the Diff Checker does not send your editor content to a YBS server.',
	},
	{
		question: 'Can I ignore whitespace differences?',
		answer: 'Yes. You can ignore whitespace, case, blank lines, or line-ending differences independently before reviewing the results.',
	},
] as const;
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqItems.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: { '@type': 'Answer', text: item.answer },
	})),
};
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalPath="/tools/diff-checker">
	<Fragment slot="head">
		<script is:inline type="application/ld+json" set:html={JSON.stringify(webApplicationSchema)} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
	</Fragment>
	<ToolLayout>
		<span slot="breadcrumb">Diff Checker &amp; Merge Tool</span>
		<ToolHeader title="Online Diff Checker" description="Compare text or code side by side, inspect differences line by line, and copy changes between versions." />

		<div class="space-y-5">
			<DiffToolbar />
			<div class="grid gap-4 md:grid-cols-2">
				<DiffEditor id="original-text" label="Original" placeholder="Paste original code here..." />
				<DiffEditor id="modified-text" label="Modified" placeholder="Paste modified code here..." />
			</div>
			<DiffSummary />
			<DiffViewer />
			<div class="rounded-xl border border-blue-100 bg-blue-50 p-4 text-sm leading-6 text-blue-900 dark:border-blue-900 dark:bg-blue-950 dark:text-blue-200">
				<strong>Private by design:</strong> comparison and merging happen entirely in your browser. No text is uploaded or stored.
			</div>
		</div>

		<div class="mt-10 space-y-6">
			<section class="content-card" aria-labelledby="compare-text-code-heading">
				<h2 id="compare-text-code-heading">Compare Text and Code Online</h2>
				<p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300">Use the two editors to review revisions without switching between files or manually scanning every line. The comparison groups matching content and clearly labels additions, removals, and modified blocks, with character-level highlighting inside paired changed lines. It works with any plain-text content, so you can inspect source-code revisions, JSON and other configuration files, SQL queries, documentation drafts, or ordinary text files. Comparison options let you disregard whitespace, letter case, blank lines, or line-ending styles when those differences are not relevant. You can move through each result with the Previous and Next controls, then copy individual changed blocks or an entire version between the Original and Modified editors.</p>
			</section>

			<section class="content-card" aria-labelledby="how-to-use-heading">
				<h2 id="how-to-use-heading">How to Use the Diff Checker</h2>
				<ol class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-6 text-slate-600 dark:text-slate-300">
					<li>Paste the earlier version into <strong>Original</strong>.</li>
					<li>Paste the updated version into <strong>Modified</strong>.</li>
					<li>Select any comparison options you need; results update automatically.</li>
					<li>Review the labeled blocks and character-level highlights.</li>
					<li>Copy individual blocks or accept all content from either version when you want to merge changes.</li>
				</ol>
			</section>

			<section class="content-card" aria-labelledby="difference-meaning-heading">
				<h2 id="difference-meaning-heading">What the Differences Mean</h2>
				<p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300"><strong>Added</strong> blocks appear only in the Modified version, while <strong>Removed</strong> blocks appear only in Original. <strong>Modified</strong> blocks pair replaced lines from both versions and mark the changed characters within them. Every block has a text label in addition to visual highlighting, and line numbers help you locate the same change in the source file.</p>
			</section>

			<section class="content-card" aria-labelledby="common-uses-heading">
				<h2 id="common-uses-heading">Common Uses</h2>
				<ul class="mt-3 grid gap-2 text-sm text-slate-600 sm:grid-cols-2 dark:text-slate-300">
					<li class="rounded-lg border border-slate-200 p-3 dark:border-slate-700"><strong class="block text-slate-900 dark:text-white">Code changes</strong>Review revisions to functions, templates, or scripts.</li>
					<li class="rounded-lg border border-slate-200 p-3 dark:border-slate-700"><strong class="block text-slate-900 dark:text-white">JSON and configuration</strong>Spot changed keys, values, and environment settings.</li>
					<li class="rounded-lg border border-slate-200 p-3 dark:border-slate-700"><strong class="block text-slate-900 dark:text-white">SQL comparison</strong>Compare queries, migrations, and schema definitions.</li>
					<li class="rounded-lg border border-slate-200 p-3 dark:border-slate-700"><strong class="block text-slate-900 dark:text-white">Documentation and text</strong>Review edits to articles, notes, and plain-text files.</li>
				</ul>
			</section>

			<section class="content-card" aria-labelledby="private-diff-heading">
				<h2 id="private-diff-heading">Private Browser-Based Diff Checker</h2>
				<p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300">Comparison, highlighting, copying, and downloads are handled by code running in your browser. The Diff Checker does not upload the contents of either editor to a YBS application server. Normal requests for the website itself may still create standard hosting and security logs, as described in the <a href="/privacy" class="font-semibold text-blue-600 hover:underline dark:text-blue-400">privacy policy</a>.</p>
			</section>

			<section class="content-card" aria-labelledby="faq-heading">
				<h2 id="faq-heading">Diff Checker FAQ</h2>
				<div class="mt-3 divide-y divide-slate-200 dark:divide-slate-700">
					{faqItems.map((item) => (
						<article class="py-4 first:pt-0 last:pb-0">
							<h3 class="font-bold text-slate-900 dark:text-white">{item.question}</h3>
							<p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300">{item.answer}</p>
						</article>
					))}
				</div>
			</section>

			<section class="content-card" aria-labelledby="related-tools-heading">
				<h2 id="related-tools-heading">Related Tools</h2>
				<div class="mt-3 grid gap-2 sm:grid-cols-2">
					<a href="/tools/json-formatter" class="related-link"><span>JSON Formatter</span><span aria-hidden="true">&rarr;</span></a>
					<a href="/tools/json-builder" class="related-link"><span>JSON Builder</span><span aria-hidden="true">&rarr;</span></a>
					<a href="/tools/base64-encoder" class="related-link"><span>Base64 Encoder &amp; Decoder</span><span aria-hidden="true">&rarr;</span></a>
					<a href="/tools/jwt-decoder" class="related-link"><span>JWT Decoder</span><span aria-hidden="true">&rarr;</span></a>
				</div>
			</section>
		</div>
	</ToolLayout>
	<script src="../../scripts/diff-checker.ts"></script>
</BaseLayout>

<style>
	:global(button:disabled) { cursor: not-allowed; opacity: 0.45; }
	:global(.diff-block) { border-bottom: 1px solid rgb(226 232 240); }
	:global(.diff-block:last-child) { border-bottom: 0; }
	:global(.diff-block:focus) { outline: 3px solid rgb(147 197 253); outline-offset: -3px; }
	:global(.diff-block-heading) { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem; padding: .5rem 1rem; background: rgb(248 250 252); }
	:global(.diff-label) { display: inline-flex; align-items: center; gap: .4rem; font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: rgb(71 85 105); }
	:global(.diff-resolution-status) { border-radius: 9999px; background: rgb(226 232 240); padding: .15rem .5rem; font-size: .65rem; letter-spacing: 0; text-transform: none; }
	:global(.diff-resolutions) { display: flex; flex-wrap: wrap; gap: .35rem; }
	:global(.diff-resolutions button) { border: 1px solid rgb(203 213 225); border-radius: .4rem; padding: .25rem .55rem; background: white; font-size: .75rem; font-weight: 600; color: rgb(51 65 85); }
	:global(.diff-resolutions button[aria-pressed="true"]) { border-color: rgb(37 99 235); background: rgb(37 99 235); color: white; }
	:global(.diff-sides) { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
	:global(.diff-side:first-child) { border-right: 1px solid rgb(226 232 240); }
	:global(.diff-line) { display: grid; min-height: 1.75rem; grid-template-columns: 3.25rem minmax(0, 1fr); font-size: .8125rem; line-height: 1.75rem; }
	:global(.diff-line > span:first-child) { user-select: none; border-right: 1px solid rgb(226 232 240); padding: 0 .65rem; text-align: right; color: rgb(100 116 139); }
	:global(.diff-line code) { overflow-wrap: anywhere; padding: 0 .75rem; white-space: pre-wrap; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; color: rgb(30 41 59); }
	:global(.diff-omitted) { border-block: 1px dashed rgb(203 213 225); background: rgb(248 250 252); padding: .45rem 1rem; text-align: center; font-size: .75rem; font-weight: 600; color: rgb(100 116 139); }
	:global(.diff-result) { border-top: 1px solid rgb(191 219 254); background: rgb(239 246 255); }
	:global(.diff-result-title) { border-bottom: 1px solid rgb(191 219 254); padding: .4rem 1rem; font-size: .7rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: rgb(29 78 216); }
	:global(.diff-added .diff-side:last-child), :global(.diff-changed .diff-side:last-child) { background: rgb(236 253 245); box-shadow: inset 3px 0 rgb(16 185 129); }
	:global(.diff-removed .diff-side:first-child), :global(.diff-changed .diff-side:first-child) { background: rgb(254 242 242); box-shadow: inset 3px 0 rgb(239 68 68); }
	:global(.diff-resolved-left .diff-side:first-child), :global(.diff-resolved-right .diff-side:last-child), :global(.diff-resolved-both .diff-side) { position: relative; box-shadow: inset 0 0 0 3px rgb(37 99 235); }
	:global(.diff-resolved-left .diff-side:last-child), :global(.diff-resolved-right .diff-side:first-child) { opacity: .55; }
	:global(.diff-line-empty) { color: rgb(148 163 184); }
	:global(.diff-placeholder) { font-style: italic; opacity: .7; }
	:global(.diff-inline) { border-radius: .2rem; padding: .05rem .08rem; color: inherit; }
	:global(.diff-inline-removed) { background: rgb(254 202 202); text-decoration: line-through; text-decoration-thickness: 1px; }
	:global(.diff-inline-added) { background: rgb(187 247 208); }
	:global(.diff-current) { position: relative; box-shadow: inset 0 0 0 2px rgb(59 130 246); }
	@media (max-width: 640px) {
		:global(.diff-sides) { grid-template-columns: 1fr; }
		:global(.diff-side:first-child) { border-right: 0; border-bottom: 1px solid rgb(226 232 240); }
	}
	:global([data-theme="dark"] .diff-block) { border-color: rgb(39 52 73); }
	:global([data-theme="dark"] .diff-block-heading) { background: rgb(23 32 51); }
	:global([data-theme="dark"] .diff-label) { color: rgb(203 213 225); }
	:global([data-theme="dark"] .diff-resolution-status) { background: rgb(39 52 73); }
	:global([data-theme="dark"] .diff-resolutions button) { border-color: rgb(51 65 85); background: rgb(15 23 42); color: rgb(226 232 240); }
	:global([data-theme="dark"] .diff-resolutions button[aria-pressed="true"]) { border-color: rgb(59 130 246); background: rgb(37 99 235); }
	:global([data-theme="dark"] .diff-side:first-child), :global([data-theme="dark"] .diff-line > span:first-child) { border-color: rgb(39 52 73); }
	:global([data-theme="dark"] .diff-line code) { color: rgb(226 232 240); }
	:global([data-theme="dark"] .diff-omitted) { border-color: rgb(51 65 85); background: rgb(23 32 51); color: rgb(148 163 184); }
	:global([data-theme="dark"] .diff-result) { border-color: rgb(30 64 175); background: rgb(23 37 84); }
	:global([data-theme="dark"] .diff-result-title) { border-color: rgb(30 64 175); color: rgb(147 197 253); }
	:global([data-theme="dark"] .diff-changed .diff-block-heading) { background: rgb(55 43 18); }
	:global([data-theme="dark"] .diff-added .diff-side:last-child), :global([data-theme="dark"] .diff-changed .diff-side:last-child) { background: rgb(6 40 35); }
	:global([data-theme="dark"] .diff-removed .diff-side:first-child), :global([data-theme="dark"] .diff-changed .diff-side:first-child) { background: rgb(55 20 25); }
	:global([data-theme="dark"] .diff-inline-removed) { background: rgb(127 29 29 / .75); }
	:global([data-theme="dark"] .diff-inline-added) { background: rgb(20 83 45 / .8); }
</style>
