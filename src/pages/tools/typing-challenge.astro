---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { typingModeLabels, typingModes } from '../../data/typingSamples';

const pageTitle = 'Typing Speed Test for Developers | YBS';
const pageDescription = 'Test your typing speed with JavaScript, JSON, SQL, HTML/CSS, and word challenges. Measure WPM and accuracy directly in your browser.';
const schema = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: 'YBS Typing Challenge',
	url: 'https://ybstools.com/tools/typing-challenge/',
	applicationCategory: 'GameApplication',
	operatingSystem: 'Any',
	description: pageDescription,
	publisher: { '@type': 'Organization', name: 'YBS', url: 'https://ybstools.com/' },
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	featureList: ['Words typing test', 'JavaScript typing practice', 'JSON typing practice', 'SQL typing practice', 'HTML and CSS typing practice', 'WPM and accuracy statistics'],
};
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalPath="/tools/typing-challenge/">
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
	<section class="page-container py-6 sm:py-7">
		<nav class="mb-4 text-sm text-slate-500 dark:text-slate-400" aria-label="Breadcrumb"><a href="/" class="hover:text-blue-600">Home</a><span class="mx-2" aria-hidden="true">/</span><span class="text-slate-700 dark:text-slate-300">Typing Challenge</span></nav>
		<header class="mb-4">
			<p class="eyebrow">Developer game</p>
			<h1 class="mt-1 text-3xl font-extrabold tracking-tight text-slate-950 dark:text-white sm:text-4xl">Developer Typing Challenge</h1>
			<p class="mt-2 max-w-3xl leading-7 text-slate-600 dark:text-slate-300">Practice prose or real code syntax and measure your speed, accuracy, and total mistakes.</p>
		</header>

		<section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900" aria-labelledby="game-heading">
			<h2 id="game-heading" class="sr-only">Typing game</h2>
			<div class="border-b border-slate-200 p-3 dark:border-slate-700 sm:px-5 sm:py-3.5">
				<div class="control-grid">
					<div class="control-group" role="group" aria-labelledby="mode-control-label">
						<p id="mode-control-label" class="control-label">Mode</p>
						<div class="control-options mode-options">
						{typingModes.map((mode, index) => <button type="button" class:list={['mode-button', index === 0 && 'mode-button-active']} data-mode={mode} aria-pressed={index === 0 ? 'true' : 'false'}>{typingModeLabels[mode]}</button>)}
						</div>
					</div>
					<div class="control-group" role="group" aria-labelledby="difficulty-control-label">
						<p id="difficulty-control-label" class="control-label">Difficulty</p>
						<div class="control-options">
						{['easy', 'medium', 'hard'].map((difficulty) => <button type="button" class:list={['difficulty-button', difficulty === 'medium' && 'difficulty-button-active']} data-difficulty={difficulty} aria-pressed={difficulty === 'medium' ? 'true' : 'false'}>{difficulty[0].toUpperCase() + difficulty.slice(1)}</button>)}
						</div>
					</div>
					<div class="control-group" role="group" aria-labelledby="duration-control-label">
						<p id="duration-control-label" class="control-label">Duration</p>
						<div class="control-options">
						{[15, 30, 60].map((seconds) => <button type="button" class:list={['timer-button', seconds === 30 && 'timer-button-active']} data-duration={seconds} aria-pressed={seconds === 30 ? 'true' : 'false'}>{seconds}s</button>)}
						</div>
					</div>
				</div>
			</div>

			<div class="p-4 sm:px-5 sm:py-4">
				<div class="timer-panel">
					<div class="flex items-center justify-center gap-2"><svg class="size-5 text-violet-500" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="13" r="8" stroke="currentColor" stroke-width="2"/><path d="M12 9v4l2.5 1.5M9 3h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><time id="time-value" class="typing-timer" aria-label="30 seconds remaining">00:30</time></div>
					<div class="timer-meta">
						<span id="challenge-label">Words challenge</span><span aria-hidden="true">•</span><span id="personal-best">Personal best: —</span>
					</div>
				</div>
				<div class="timer-track" id="timer-track" role="progressbar" aria-label="Time remaining" aria-valuemin="0" aria-valuemax="30" aria-valuenow="30"><span id="timer-progress" class="timer-progress"></span></div>
				<div class="stats-row">
					<dl class="grid grid-cols-3" aria-label="Live typing statistics">
						<div class="game-stat"><dt>WPM</dt><dd id="wpm-value">0</dd></div>
						<div class="game-stat"><dt>Accuracy</dt><dd id="accuracy-value">100%</dd></div>
						<div class="game-stat"><dt>Errors</dt><dd id="mistakes-value">0</dd></div>
					</dl>
				</div>
				<pre id="target-text" class="typing-target" aria-label="Text to type"></pre>
				<label for="typing-input" class="mt-3 block text-sm font-bold text-slate-800 dark:text-slate-100">Type the sample</label>
				<textarea id="typing-input" class="typing-input" rows="4" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" placeholder="Start typing here..." aria-describedby="typing-help"></textarea>
				<p id="typing-help" class="mt-1 text-xs leading-5 text-slate-500 dark:text-slate-400">Code modes preserve spaces, punctuation, indentation, and line breaks. Tab inserts indentation. Your typing stays in your browser.</p>

				<p class="mt-3 text-center text-xs font-semibold text-slate-500 dark:text-slate-400">Current streak: <span id="streak-value">0</span></p>

				<div class="mt-4 flex flex-wrap gap-3">
					<button id="restart-button" type="button" class="button-secondary">Restart</button>
					<button id="new-challenge-button" type="button" class="button-primary">New challenge</button>
					<button id="reset-scores-button" type="button" class="button-secondary sm:ml-auto">Reset personal bests</button>
				</div>
				<p id="game-status" class="sr-only" aria-live="polite"></p>
			</div>
		</section>

		<section id="results-panel" class="mt-6 hidden rounded-2xl border border-violet-200 bg-violet-50 p-5 shadow-sm dark:border-violet-900 dark:bg-violet-950 sm:p-6" aria-labelledby="results-heading">
			<p class="text-xs font-black uppercase tracking-widest text-violet-600 dark:text-violet-300">Challenge complete</p>
			<h2 id="results-heading" class="mt-1 text-2xl font-extrabold text-slate-950 dark:text-white">Your results</h2>
			<dl class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
				<div class="result-stat"><dt>WPM</dt><dd id="result-wpm">0</dd></div><div class="result-stat"><dt>Accuracy</dt><dd id="result-accuracy">100%</dd></div><div class="result-stat"><dt>Mistakes</dt><dd id="result-mistakes">0</dd></div><div class="result-stat"><dt>Incorrect</dt><dd id="result-incorrect">0</dd></div><div class="result-stat"><dt>Characters</dt><dd id="result-characters">0</dd></div><div class="result-stat"><dt>Mode</dt><dd id="result-mode">Words</dd></div><div class="result-stat"><dt>Difficulty</dt><dd id="result-difficulty">Medium</dd></div>
			</dl>
			<p id="best-message" class="mt-4 font-bold text-violet-700 dark:text-violet-200"></p>
			<div class="mt-5 flex flex-wrap gap-3"><button id="try-again-button" type="button" class="button-primary">Try Again</button><button id="result-new-button" type="button" class="button-secondary">New Challenge</button><button id="copy-result-button" type="button" class="button-secondary">Copy Result</button></div>
		</section>

		<div class="mt-10 grid gap-6 lg:grid-cols-[2fr_1fr]">
			<div class="space-y-6">
				<article class="content-card"><h2>Developer typing test</h2><p>Typing code differs from ordinary prose because every quote, brace, semicolon, space, and line break matters. Code modes help you practice those precise movements while keeping the sample readable.</p></article>
				<article class="content-card"><h2>How WPM is calculated</h2><p>WPM uses the standard five-character convention: typed characters divided by five, then divided by elapsed minutes. Only characters you actually type are included.</p></article>
				<article class="content-card"><h2>Practice typing code</h2><p>Generate fresh challenges directly in your browser. Choose JavaScript, JSON, SQL, or HTML/CSS and adjust the difficulty to change syntax, nesting, punctuation, and length. Words mode creates readable prose practice.</p></article>
				<article class="content-card"><h2>How to use the typing challenge</h2><ol><li><strong>1.</strong> Choose a mode and a 15, 30, or 60-second timer.</li><li><strong>2.</strong> Begin typing; the timer starts with your first character.</li><li><strong>3.</strong> Follow the correct, incorrect, and current-character indicators while reviewing live statistics.</li><li><strong>4.</strong> Review your result, try again, choose a new sample, or copy the result text.</li></ol></article>
			</div>
			<aside class="content-card self-start"><h2>Private browser-based practice</h2><p>Your typing stays in your browser. The game makes no network requests and stores only best WPM statistics by mode and difficulty—not typed or generated challenge content.</p></aside>
		</div>
	</section>
	<script src="../../scripts/typing-challenge.ts"></script>
</BaseLayout>

<style>
	.mode-button, .timer-button, .difficulty-button { border: 1px solid rgb(203 213 225); border-radius: .6rem; padding: .5rem .75rem; color: rgb(71 85 105); font-size: .78rem; font-weight: 700; }
	.mode-button:hover, .timer-button:hover, .difficulty-button:hover { border-color: rgb(139 92 246); color: rgb(109 40 217); }
	.mode-button:focus-visible, .timer-button:focus-visible, .difficulty-button:focus-visible { outline: 3px solid rgb(221 214 254); outline-offset: 2px; }
	.mode-button-active, .timer-button-active, .difficulty-button-active { border-color: rgb(124 58 237); background: rgb(124 58 237); color: white; }
	.mode-button-active:hover, .timer-button-active:hover, .difficulty-button-active:hover { color: white; }
	.control-grid { display: grid; gap: .75rem; }
	.control-group { min-width: 0; }
	.control-label { margin-bottom: .3rem; color: rgb(100 116 139); font-size: .62rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
	.control-options { display: flex; gap: .35rem; }
	.mode-options { scrollbar-width: none; overflow-x: auto; padding: 2px; }
	.mode-options::-webkit-scrollbar { display: none; }
	.timer-panel { height: 68px; text-align: center; }
	.typing-timer { display: block; color: rgb(15 23 42); font: 800 clamp(2rem, 5vw, 2.75rem)/1 ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: -.04em; transition: color .2s ease; }
	.timer-track { width: 100%; height: 3px; margin: 0 0 .65rem; overflow: hidden; border-radius: 999px; background: rgb(226 232 240); }
	.timer-progress { display: block; width: 100%; height: 100%; border-radius: inherit; background: rgb(124 58 237); transition: width .2s linear, background-color .2s ease; }
	.timer-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .3rem .65rem; margin-top: .3rem; color: rgb(100 116 139); font-size: .7rem; font-weight: 700; }
	.typing-timer-urgent { color: rgb(180 83 9); }
	.timer-progress-urgent { background: rgb(245 158 11); }
	.stats-row { height: 60px; margin-bottom: .75rem; border-block: 1px solid rgb(226 232 240); padding-block: .4rem; }
	.game-stat { min-width: 0; border-left: 1px solid rgb(226 232 240); }
	.game-stat:first-child { border-left: 0; }
	.game-stat dt { color: rgb(100 116 139); font-size: .68rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
	.game-stat dd { margin-top: .1rem; color: rgb(15 23 42); font-size: 1.35rem; line-height: 1.1; font-weight: 800; }
	.typing-target { min-height: 7rem; max-height: 12rem; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; border: 1px solid rgb(226 232 240); border-radius: .85rem; background: rgb(248 250 252); padding: .75rem 1.25rem; color: rgb(100 116 139); font: 500 1.125rem/1.7 ui-monospace, SFMono-Regular, Consolas, monospace; tab-size: 2; }
	.typing-input { height: 5.5rem; min-height: 5rem; margin-top: .35rem; display: block; width: 100%; resize: vertical; border: 1px solid rgb(203 213 225); border-radius: .85rem; background: white; padding: .7rem 1rem; color: rgb(15 23 42); font: 500 1rem/1.55 ui-monospace, SFMono-Regular, Consolas, monospace; outline: none; tab-size: 2; }
	.typing-input:focus { border-color: rgb(124 58 237); box-shadow: 0 0 0 4px rgb(237 233 254); }
	:global(.typing-correct) { color: rgb(22 101 52); text-decoration: underline solid rgb(34 197 94 / .5); text-underline-offset: .25rem; }
	:global(.typing-incorrect) { border-radius: .15rem; background: rgb(254 226 226); color: rgb(153 27 27); text-decoration: underline wavy currentColor; text-underline-offset: .2rem; }
	:global(.typing-current) { border-radius: .15rem; outline: 2px solid rgb(124 58 237); outline-offset: 1px; background: rgb(237 233 254); color: rgb(76 29 149); }
	.result-stat { border-radius: .75rem; background: rgb(255 255 255 / .72); padding: .8rem; }
	.result-stat dt { color: rgb(100 116 139); font-size: .7rem; font-weight: 800; text-transform: uppercase; }
	.result-stat dd { margin-top: .25rem; color: rgb(15 23 42); font-size: 1.25rem; font-weight: 800; overflow-wrap: anywhere; }
	:global([data-theme="dark"]) .mode-button, :global([data-theme="dark"]) .timer-button, :global([data-theme="dark"]) .difficulty-button { border-color: rgb(51 65 85); color: rgb(203 213 225); }
	:global([data-theme="dark"]) .mode-button-active, :global([data-theme="dark"]) .timer-button-active, :global([data-theme="dark"]) .difficulty-button-active { border-color: rgb(139 92 246); background: rgb(124 58 237); color: white; }
	:global([data-theme="dark"]) .typing-timer, :global([data-theme="dark"]) .game-stat dd { color: white; }
	:global([data-theme="dark"]) .typing-timer-urgent { color: rgb(253 186 116); }
	:global([data-theme="dark"]) .timer-track { background: rgb(51 65 85); }
	:global([data-theme="dark"]) .game-stat, :global([data-theme="dark"]) .stats-row { border-color: rgb(51 65 85); }
	:global([data-theme="dark"]) .typing-target { border-color: rgb(51 65 85); background: rgb(15 23 42); color: rgb(148 163 184); }
	:global([data-theme="dark"]) .typing-input { border-color: rgb(51 65 85); background: rgb(15 23 42); color: rgb(241 245 249); }
	:global([data-theme="dark"]) .typing-input:focus { box-shadow: 0 0 0 4px rgb(76 29 149 / .5); }
	:global([data-theme="dark"]) .typing-correct { color: rgb(134 239 172); }
	:global([data-theme="dark"]) .typing-incorrect { background: rgb(127 29 29 / .6); color: rgb(254 202 202); }
	:global([data-theme="dark"]) .typing-current { background: rgb(76 29 149); color: white; }
	:global([data-theme="dark"]) .result-stat { background: rgb(15 23 42 / .7); }
	:global([data-theme="dark"]) .result-stat dd { color: white; }
	@media (min-width: 1024px) { .control-grid { grid-template-columns: minmax(0, 2fr) auto auto; align-items: end; gap: 1.25rem; } }
	@media (max-width: 639px) { .timer-panel { height: 62px; } .typing-timer { font-size: 2rem; } .timer-meta { margin-top: .25rem; } .stats-row { height: 56px; } .typing-target { min-height: 6.5rem; font-size: 1rem; } .typing-input { height: 5rem; } }
</style>
