---
import BaseLayout from '../../layouts/BaseLayout.astro'; import ToolLayout from '../../components/ToolLayout.astro'; import ToolHeader from '../../components/ToolHeader.astro';
const title='Cron Expression Tester - Cron Schedule Checker | YBS'; const description='Test and explain Unix cron expressions, validate cron syntax, and preview upcoming run times in local time or UTC directly in your browser.';
const faqs=[['What is a cron expression?','A cron expression is a compact schedule made from time and calendar fields. This tester uses standard five-field Unix cron.'],['How many fields does a Unix cron expression have?','Standard Unix cron uses five fields: minute, hour, day of month, month, and day of week.'],['What does * mean in cron?','An asterisk selects every allowed value for that field.'],['What does */5 mean in cron?','It selects every fifth value, such as every five minutes in the minute field.'],['How do I run a cron job every 5 minutes?','Use */5 * * * *.'],['How do I run cron every weekday?','Use 0 9 * * 1-5 for 9:00 AM Monday through Friday.'],['Does cron use local time or UTC?','Cron environments vary. This tester calculates schedules consistently using the Local Time or UTC mode you select.'],['What happens when both day-of-month and day-of-week are specified?','This tester follows common Unix/Vixie behavior: when both fields are restricted, a date matches when either field matches.'],['Does this tester support Quartz cron?','No. It supports standard five-field Unix cron, not Quartz, AWS, Jenkins extensions, seconds, or year fields.'],['Are my cron expressions uploaded?','No. Your cron expression is processed entirely in your browser.']];
const schema={'@context':'https://schema.org','@type':'WebApplication',name:'YBS Cron Expression Tester',applicationCategory:'DeveloperApplication',operatingSystem:'Any',url:'https://ybstools.com/tools/cron-expression-tester/',description,offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}}; const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
const presets=[['Every minute','* * * * *'],['Every 5 minutes','*/5 * * * *'],['Every 15 minutes','*/15 * * * *'],['Every hour','0 * * * *'],['Every day at midnight','0 0 * * *'],['Every day at 9 AM','0 9 * * *'],['Weekdays at 9 AM','0 9 * * 1-5'],['Every Monday at 9 AM','0 9 * * 1'],['First day of every month','0 0 1 * *']]; const fieldCards=[['minute','Minute','0–59'],['hour','Hour','0–23'],['dayOfMonth','Day','1–31'],['month','Month','1–12'],['dayOfWeek','Weekday','0–7']];
---
<BaseLayout title={title} description={description} canonicalPath="/tools/cron-expression-tester/"><Fragment slot="head"><script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} /><script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} /></Fragment><ToolLayout><span slot="breadcrumb">Cron Expression Tester</span><ToolHeader title="Cron Expression Tester" description="Test and explain standard 5-field Unix cron expressions and preview upcoming run times directly in your browser." /><p class="mb-4 inline-flex rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700 dark:border-blue-800 dark:bg-blue-950 dark:text-blue-200">Standard 5-field Unix cron</p>
	<section class="content-card cron-tool" aria-labelledby="cron-input-heading"><div class="flex flex-wrap items-end gap-3"><div class="min-w-0 flex-1"><label id="cron-input-heading" for="cron-input" class="field-label">Cron expression</label><input id="cron-input" class="cron-input" value="*/15 9-17 * * 1-5" placeholder="*/15 9-17 * * 1-5" autocomplete="off" spellcheck="false" aria-describedby="cron-validation" /></div><button id="copy-cron" type="button" class="button-secondary">Copy expression</button><button id="reset-cron" type="button" class="button-secondary">Reset</button></div><div class="mt-3 flex flex-wrap items-center gap-3"><label for="cron-preset" class="text-xs font-bold">Preset</label><select id="cron-preset" class="control"><option value="">Choose a preset…</option>{presets.map(([label,value])=><option value={value}>{label}</option>)}</select><div class="mode-toggle" role="group" aria-label="Schedule timezone"><button type="button" data-time-mode="local" class="toggle-active" aria-pressed="true">Local Time</button><button type="button" data-time-mode="utc" aria-pressed="false">UTC</button></div></div><p id="cron-validation" class="validation-message" role="status" aria-live="polite"></p><p id="cron-explanation" class="explanation"></p><div class="field-grid">{fieldCards.map(([key,label,range])=><article data-cron-field={key}><span>{label} <small>{range}</small></span><strong></strong><p></p></article>)}</div><section class="runs-panel" aria-labelledby="next-runs-heading"><div class="flex flex-wrap items-center justify-between gap-2"><h2 id="next-runs-heading">Next 5 Runs</h2><span class="text-xs text-slate-500">Next runs • <strong id="runs-mode">Local Time</strong></span></div><ol id="next-runs"></ol><p id="runs-error" class="error-box" hidden></p><p class="mt-3 text-xs text-slate-500">Schedules use the selected Local or UTC mode. Runs are strictly after the current instant.</p></section><p class="mt-4 text-center text-xs text-slate-500">Your cron expression is processed entirely in your browser.</p><p id="cron-status" class="sr-only" aria-live="polite"></p></section>
	<div class="mt-10 grid gap-6 lg:grid-cols-[2fr_1fr]"><div class="space-y-6"><article class="content-card"><h2>What is a Cron Expression?</h2><p>A standard Unix cron expression describes a recurring schedule with five fields for minute, hour, day of month, month, and day of week.</p></article><article class="content-card"><h2>Cron Expression Format</h2><pre class="cron-format">* * * * *&#10;│ │ │ │ └─ day of week&#10;│ │ │ └─── month&#10;│ │ └───── day of month&#10;│ └─────── hour&#10;└───────── minute</pre></article><article class="content-card"><h2>Cron Expression Examples</h2><div class="table-wrap"><table><tbody>{presets.slice(0,7).map(([label,value])=><tr><td><code>{value}</code></td><td>{label}</td></tr>)}</tbody></table></div></article><article class="content-card"><h2>Cron Special Characters</h2><p><code>*</code> selects all values, commas create lists, hyphens create ranges, and <code>/</code> applies a step. JAN–DEC and SUN–SAT names are supported.</p></article><article class="content-card"><h2>Day of Month vs Day of Week</h2><p>When both fields are restricted, this tester uses common Unix/Vixie OR semantics: either field may match.</p></article><article class="content-card"><h2>Local Time vs UTC</h2><p>Local mode uses your browser timezone. UTC mode constructs and evaluates calendar fields in UTC.</p></article><article class="content-card"><h2>Privacy</h2><p>Parsing, explanation, and scheduling run locally. Cron input is treated as text and is never executed or uploaded.</p></article></div><div class="space-y-6"><aside class="content-card"><h2>Frequently asked questions</h2><div class="mt-2 divide-y divide-slate-200 dark:divide-slate-700">{faqs.map(([q,a])=><details class="py-3"><summary class="cursor-pointer text-sm font-semibold">{q}</summary><p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{a}</p></details>)}</div></aside><aside class="content-card"><h2>Related tools</h2><div class="mt-3 space-y-2 text-sm"><a class="related-link" href="/tools/unix-timestamp-converter/"><span>Unix Timestamp Converter</span><span>→</span></a><a class="related-link" href="/tools/regex-tester/"><span>Regex Tester</span><span>→</span></a></div></aside></div></div></ToolLayout><script>import '../../scripts/cron-expression-tester';</script></BaseLayout>
<style>
:global(.page-container){box-sizing:border-box;max-width:100vw}:global(body){overflow-x:hidden}
.cron-tool{padding:1rem}.field-label{display:block;font-size:.8rem;font-weight:800}.cron-input{margin-top:.4rem;width:100%;min-width:0;border:1px solid var(--border);border-radius:.75rem;background:var(--input-background);padding:.8rem 1rem;color:var(--text-primary);font-family:ui-monospace,monospace;font-size:1rem;outline:none}.cron-input:focus,.control:focus{border-color:#3b82f6;box-shadow:0 0 0 4px #3b82f626}.control{max-width:100%;border:1px solid var(--border);border-radius:.6rem;background:var(--input-background);padding:.55rem .7rem;color:var(--text-primary);outline:none}.mode-toggle{display:inline-flex;overflow:hidden;border:1px solid var(--border);border-radius:.6rem}.mode-toggle button{padding:.55rem .75rem;color:var(--text-secondary);font-size:.75rem;font-weight:700}.mode-toggle button+button{border-left:1px solid var(--border)}.mode-toggle .toggle-active{background:#2563eb;color:white}.validation-message{margin-top:1rem;border-radius:.65rem;padding:.65rem .75rem;font-size:.85rem;font-weight:700}.validation-message.valid{background:#dcfce7;color:#166534}.validation-message.invalid,.error-box{background:#fee2e2;color:#991b1b}.explanation{margin-top:.75rem;color:var(--text-primary);font-size:1.1rem;font-weight:750}.field-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.6rem;margin-top:1rem}.field-grid article{min-width:0;border:1px solid var(--border);border-radius:.75rem;background:var(--surface-secondary);padding:.7rem}.field-grid span{display:block;color:var(--text-muted);font-size:.65rem;font-weight:800;text-transform:uppercase}.field-grid strong{display:block;margin-top:.4rem;overflow-wrap:anywhere;font-family:ui-monospace,monospace}.field-grid p{margin-top:.25rem;color:var(--text-secondary);font-size:.72rem}.runs-panel{margin-top:1rem;border-top:1px solid var(--border);padding-top:1rem}.runs-panel h2{font-weight:800}.runs-panel ol{display:grid;gap:.4rem;margin-top:.75rem;counter-reset:runs}.runs-panel li{counter-increment:runs;border-radius:.55rem;background:var(--surface-secondary);padding:.55rem .7rem;font-size:.85rem}.runs-panel li:before{content:counter(runs) '.';margin-right:.6rem;color:var(--text-muted);font-weight:800}.error-box{margin-top:.75rem;border-radius:.6rem;padding:.65rem;font-size:.8rem}.cron-format{margin-top:.75rem;overflow:auto;border-radius:.7rem;background:var(--input-background);padding:1rem;font-family:ui-monospace,monospace;font-size:.8rem}.table-wrap{margin-top:.75rem;overflow-x:auto}.table-wrap table{width:100%;font-size:.85rem}.table-wrap td{border-top:1px solid var(--border);padding:.55rem}.table-wrap code{font-family:ui-monospace,monospace}:global([data-theme="dark"]) .validation-message.valid{background:#052e16;color:#bbf7d0}:global([data-theme="dark"]) .validation-message.invalid,:global([data-theme="dark"]) .error-box{background:#450a0a;color:#fecaca}@media(max-width:700px){.field-grid{grid-template-columns:1fr 1fr}.field-grid article:last-child{grid-column:1/-1}}
</style>
