---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = 'YAML Viewer, Validator & OpenAPI Explorer | YBS';
const description = 'View and validate YAML, explore OpenAPI and Swagger endpoints, search API paths, inspect schemas, and convert YAML to JSON in your browser.';
---
<BaseLayout title={title} description={description} canonicalPath="/tools/yaml-viewer/">
	<section class="page-container py-8 sm:py-10">
		<nav class="mb-4 text-sm text-slate-500 dark:text-slate-400" aria-label="Breadcrumb"><a href="/" class="hover:text-blue-600">Home</a><span class="mx-2" aria-hidden="true">/</span><span>YAML Viewer</span></nav>
		<header class="mb-6"><p class="eyebrow">Developer tool</p><h1 class="mt-1 text-3xl font-extrabold tracking-tight text-slate-950 dark:text-white sm:text-4xl">YAML Viewer, Validator &amp; OpenAPI Explorer</h1><p class="mt-2 max-w-3xl text-slate-600 dark:text-slate-300">Validate any YAML document, browse its tree, or inspect multiple endpoints in recognized OpenAPI 3.x and Swagger 2.0 specifications.</p></header>

		<div class="mb-4 flex flex-wrap gap-2 rounded-2xl border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
			<button id="validate" class="button-primary" type="button">Validate &amp; view</button><button id="format" class="button-secondary" type="button">Format YAML</button><button id="json" class="button-secondary" type="button">YAML → JSON</button>
			<label class="button-secondary cursor-pointer">Upload YAML<input id="file" class="sr-only" type="file" accept=".yaml,.yml,text/yaml,application/yaml" /></label><button id="sample" class="button-secondary" type="button">Load OpenAPI sample</button><button id="clear" class="button-secondary" type="button">Clear</button>
		</div>
		<div id="status" class="mb-4 hidden rounded-xl border px-4 py-3 text-sm" role="status" aria-live="polite"></div>
		<div class="grid gap-4 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.4fr)]">
			<section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900" aria-labelledby="yaml-heading"><div class="border-b border-slate-200 px-4 py-3 dark:border-slate-700"><h2 id="yaml-heading" class="text-sm font-semibold">YAML input</h2></div><textarea id="yaml-input" class="block min-h-[620px] w-full resize-y bg-white p-4 font-mono text-sm leading-6 outline-none focus:ring-4 focus:ring-inset focus:ring-blue-100 dark:bg-slate-900 dark:text-slate-100 dark:focus:ring-blue-900" placeholder="Paste YAML here…" spellcheck="false"></textarea></section>
			<section class="min-w-0 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900" aria-label="YAML result">
				<div id="tabs" class="hidden border-b border-slate-200 p-2 dark:border-slate-700" role="tablist" aria-label="Document view"><button id="tree-tab" class="tab" role="tab" aria-controls="tree-view" aria-selected="true" type="button">Tree View</button><button id="api-tab" class="tab hidden" role="tab" aria-controls="api-view" aria-selected="false" type="button">API View</button></div>
				<div id="empty" class="grid min-h-[620px] place-items-center p-8 text-center text-sm text-slate-500">Paste or upload YAML to begin.</div>
				<div id="tree-view" class="hidden min-h-[560px] p-4" role="tabpanel" aria-labelledby="tree-tab"><div class="mb-3 flex gap-2"><label class="sr-only" for="tree-search">Search keys and values</label><input id="tree-search" class="control flex-1" placeholder="Search keys and values…" /><button id="copy-json" class="button-secondary" type="button">Copy JSON</button></div><div id="tree" class="max-h-[690px] overflow-auto font-mono text-sm"></div></div>
				<div id="api-view" class="hidden p-4" role="tabpanel" aria-labelledby="api-tab">
					<div id="overview" class="mb-5"></div><p class="mb-4 rounded-xl border border-blue-100 bg-blue-50 p-3 text-sm text-blue-900 dark:border-blue-900 dark:bg-blue-950 dark:text-blue-200">Your API specification stays in your browser.</p>
					<div class="mb-4 flex flex-wrap gap-2"><label class="sr-only" for="endpoint-search">Search endpoints</label><input id="endpoint-search" class="control min-w-0 flex-1" placeholder="Search endpoints…" /><div id="method-filters" class="flex flex-wrap gap-1" aria-label="Filter endpoints by HTTP method"></div></div><p id="match-count" class="mb-3 text-sm text-slate-500" aria-live="off"></p>
					<div class="grid min-w-0 gap-4 xl:grid-cols-[minmax(260px,.8fr)_minmax(0,1.2fr)]"><div id="endpoint-list" class="max-h-[620px] overflow-auto rounded-xl border border-slate-200 dark:border-slate-700" aria-label="Endpoints"></div><article id="endpoint-detail" class="min-w-0 rounded-xl border border-slate-200 p-4 dark:border-slate-700"><p class="text-sm text-slate-500">Select an endpoint to inspect it.</p></article></div>
					<div class="mt-6 grid gap-4 lg:grid-cols-2"><section><h3 class="mb-2 font-bold">Schemas <span id="schema-count"></span></h3><div id="schemas" class="rounded-xl border border-slate-200 dark:border-slate-700"></div></section><section><h3 class="mb-2 font-bold">Security schemes</h3><div id="security" class="rounded-xl border border-slate-200 p-3 text-sm dark:border-slate-700"></div></section></div>
				</div>
			</section>
		</div>
		<section class="mt-10 grid gap-6 lg:grid-cols-[2fr_1fr]"><article class="content-card"><h2>OpenAPI and Swagger YAML Viewer</h2><p>OpenAPI specifications often describe many API endpoints in one YAML document. YBS automatically recognizes supported specifications and adds an endpoint-focused API View while preserving the generic Tree View.</p><p>Use it to browse large endpoint collections, review request parameters and response codes, inspect reusable schemas, and understand unfamiliar APIs. It is a read-only viewer and does not send or test requests.</p></article><aside class="content-card"><h2>Related tools</h2><div class="mt-3 space-y-2 text-sm"><a class="related-link" href="/tools/json-formatter/"><span>JSON Formatter</span><span>→</span></a><a class="related-link" href="/tools/json-builder/"><span>JSON Builder</span><span>→</span></a><a class="related-link" href="/tools/diff-checker/"><span>Diff Checker</span><span>→</span></a></div></aside></section>
	</section>
	<script src="../../scripts/yaml-viewer.ts"></script>
</BaseLayout>
<style>
	.control{border:1px solid rgb(203 213 225);border-radius:.6rem;background:transparent;padding:.55rem .75rem;font-size:.875rem;outline:none}.tab{border-radius:.55rem;padding:.5rem .8rem;font-size:.875rem;font-weight:700}.tab[aria-selected="true"]{background:#2563eb;color:white}.method{display:inline-block;min-width:4.25rem;border:1px solid currentColor;border-radius:.4rem;padding:.15rem .4rem;text-align:center;font:700 .72rem ui-monospace,monospace}.method-GET{color:#047857}.method-POST{color:#1d4ed8}.method-PUT,.method-PATCH{color:#a16207}.method-DELETE{color:#b91c1c}.method-OPTIONS,.method-HEAD,.method-TRACE{color:#6d28d9}:global(.dark) .control{border-color:rgb(71 85 105)}:global(#tree details){margin-left:1rem}:global(#tree summary){cursor:pointer;padding:.15rem}:global(#tree mark){background:#fde68a;color:#111827}
</style>
