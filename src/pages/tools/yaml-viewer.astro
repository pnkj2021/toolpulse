---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = 'YAML Viewer & API Explorer Online | YBS';
const description = 'View and validate YAML, explore API endpoints and schemas, inspect API specifications, and convert YAML to JSON directly in your browser.';
---
<BaseLayout title={title} description={description} canonicalPath="/tools/yaml-viewer/">
	<section class="page-container yaml-page py-8 sm:py-10">
		<nav class="mb-4 text-sm text-slate-500 dark:text-slate-400" aria-label="Breadcrumb"><a href="/" class="hover:text-blue-600">Home</a><span class="mx-2" aria-hidden="true">/</span><span>YAML Viewer</span></nav>
		<header class="mb-6"><p class="eyebrow">Developer tool</p><h1 class="mt-1 text-3xl font-extrabold tracking-tight text-slate-950 dark:text-white sm:text-4xl">Online YAML Viewer &amp; API Explorer</h1><p class="mt-2 max-w-3xl text-slate-600 dark:text-slate-300">Explore and inspect API specifications directly from YAML.</p></header>

		<div id="detection-banner" class="mb-4 hidden items-center gap-4 rounded-xl border border-emerald-300 bg-emerald-50 px-4 py-3 text-emerald-950 shadow-sm dark:border-emerald-800 dark:bg-emerald-950 dark:text-emerald-100" role="status" aria-live="polite"><div class="grid size-9 shrink-0 place-items-center rounded-full bg-emerald-600 font-bold text-white" aria-hidden="true">✓</div><div class="min-w-0 flex-1"><p id="detection-title" class="font-bold"></p><p id="detection-detail" class="mt-0.5 text-sm text-emerald-800 dark:text-emerald-200"></p></div><button id="explore-api" class="button-primary hidden shrink-0" type="button">Explore APIs →</button></div>
		<div id="workspace" class="workspace grid min-h-[680px] overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
			<section id="yaml-panel" class="flex min-w-0 flex-col border-b border-slate-200 dark:border-slate-700 lg:border-b-0 lg:border-r" aria-labelledby="yaml-heading"><div class="border-b border-slate-200 px-3 py-2.5 dark:border-slate-700"><div class="flex items-center gap-3"><h2 id="yaml-heading" class="mr-auto text-sm font-semibold">YAML Source</h2><button id="hide-source" class="utility-button hidden" type="button" aria-expanded="true" aria-controls="yaml-panel">Hide source</button></div><div class="mt-2 flex flex-wrap items-center gap-2" aria-label="YAML actions"><label class="secondary-action cursor-pointer">Upload YAML<input id="file" class="sr-only" type="file" accept=".yaml,.yml,text/yaml,application/yaml" /></label><button id="format" class="secondary-action" type="button">Format</button><button id="json" class="secondary-action" type="button">YAML → JSON</button><button id="copy-yaml" class="utility-button" type="button">Copy YAML</button><button id="clear" class="clear-action" type="button">Clear</button></div></div><textarea id="yaml-input" class="block min-h-[500px] flex-1 resize-none bg-white p-4 font-mono text-sm leading-6 outline-none focus:ring-4 focus:ring-inset focus:ring-blue-100 dark:bg-slate-900 dark:text-slate-100 dark:focus:ring-blue-900" placeholder="Paste YAML here…" spellcheck="false"></textarea><div class="flex flex-wrap gap-2 border-t border-slate-200 p-3 dark:border-slate-700"><button id="validate" class="button-primary" type="button">Validate &amp; view</button><button id="sample" class="button-secondary" type="button">Load API sample</button></div></section>
			<section class="flex min-w-0 flex-col overflow-hidden" aria-label="YAML result"><div id="view-toolbar" class="hidden flex-wrap items-center gap-4 border-b border-slate-200 p-2 dark:border-slate-700"><div id="tabs" class="view-segment" role="tablist" aria-label="Document view"><button id="tree-tab" class="tab" role="tab" aria-controls="tree-view" aria-selected="true" type="button">Tree View</button><button id="api-tab" class="tab hidden" role="tab" aria-controls="api-view" aria-selected="false" type="button">API Explorer</button></div><button id="toggle-yaml" class="utility-button ml-auto hidden" type="button" aria-expanded="false" aria-controls="yaml-panel">Show YAML source</button></div>
				<div id="status" class="hidden border-b border-slate-200 px-4 py-2 text-sm dark:border-slate-700" role="status" aria-live="polite"></div>
				<div id="empty" class="grid min-h-[620px] flex-1 place-items-center p-8 text-center text-sm text-slate-500"><div class="max-w-md"><div class="mx-auto grid size-12 place-items-center rounded-xl bg-blue-50 font-mono font-bold text-blue-700 dark:bg-blue-950 dark:text-blue-200">YML</div><h2 class="mt-4 text-lg font-bold text-slate-900 dark:text-white">API / YAML Preview</h2><p class="mt-1">Paste YAML to begin.</p><div class="mt-5 rounded-xl bg-slate-50 p-4 text-left leading-7 dark:bg-slate-800 dark:text-slate-300"><p class="font-semibold text-slate-800 dark:text-white">YBS can recognize API specifications and turn them into an easy-to-browse API Explorer.</p><p class="mt-2">Explore:</p><p>• Endpoints<br />• Parameters<br />• Request bodies<br />• Responses<br />• Schemas<br />• Servers</p></div></div></div>
				<div id="tree-view" class="hidden min-h-0 flex-1 p-4" role="tabpanel" aria-labelledby="tree-tab" tabindex="0"><div class="mb-3 flex flex-wrap gap-2"><label class="sr-only" for="tree-search">Search keys and values</label><input id="tree-search" class="control min-w-0 flex-1" placeholder="Search keys and values…" /><button id="expand-tree" class="button-secondary" type="button">Expand all</button><button id="collapse-tree" class="button-secondary" type="button">Collapse all</button><button id="copy-json" class="button-secondary" type="button">Copy JSON</button></div><div id="tree" class="explorer-scroll overflow-auto font-mono text-sm" tabindex="0"></div></div>
				<div id="api-view" class="hidden min-h-0 flex-1 flex-col" role="tabpanel" aria-labelledby="api-tab"><header id="overview" class="border-b border-slate-200 px-4 py-3 dark:border-slate-700"></header><div class="flex flex-wrap items-center gap-3 border-b border-slate-200 px-4 py-2 dark:border-slate-700"><div class="section-tabs" role="tablist" aria-label="API explorer section"><button id="endpoints-mode" class="section-tab" role="tab" aria-selected="true" aria-controls="endpoints-explorer" type="button">Endpoints</button><button id="schemas-mode" class="section-tab" role="tab" aria-selected="false" aria-controls="schemas-explorer" type="button">Schemas</button></div><p class="ml-auto text-xs text-slate-500">Your API specification stays in your browser.</p></div>
					<section id="endpoints-explorer" class="flex min-h-0 flex-1 flex-col" role="tabpanel" aria-labelledby="endpoints-mode"><div class="border-b border-slate-200 bg-white px-4 py-3 dark:border-slate-700 dark:bg-slate-900"><div class="flex flex-wrap gap-3"><label class="sr-only" for="endpoint-search">Search endpoints</label><input id="endpoint-search" class="control min-w-[220px] flex-1" placeholder="Search endpoints…" /><div id="method-filters" class="filter-strip flex max-w-full gap-1 overflow-x-auto" aria-label="Filter endpoints by HTTP method"></div></div><p id="match-count" class="mt-2 text-xs text-slate-500" aria-live="off"></p></div><div class="explorer-columns grid min-h-0 flex-1"><nav id="endpoint-list" class="explorer-scroll overflow-auto border-b border-slate-200 dark:border-slate-700 lg:border-b-0 lg:border-r" aria-label="Endpoints" tabindex="0"></nav><article id="endpoint-detail" class="explorer-scroll min-w-0 overflow-auto p-5" tabindex="0"><p class="text-sm text-slate-500">Select an endpoint to inspect its details.</p></article></div></section>
					<section id="schemas-explorer" class="hidden min-h-0 flex-1" role="tabpanel" aria-labelledby="schemas-mode"><div class="schema-columns grid h-full min-h-0"><nav class="explorer-scroll overflow-auto border-b border-slate-200 p-3 dark:border-slate-700 lg:border-b-0 lg:border-r" aria-label="Schemas" tabindex="0"><h3 class="mb-2 px-2 text-xs font-bold uppercase tracking-wide text-slate-500">Schemas <span id="schema-count"></span></h3><div id="schema-list"></div></nav><article id="schema-detail" class="explorer-scroll min-w-0 overflow-auto p-5" tabindex="0"></article></div></section>
				</div>
			</section>
		</div>
		<section class="mt-10 grid gap-6 lg:grid-cols-[2fr_1fr]"><article class="content-card"><h2>Explore APIs from YAML</h2><p>Explore and inspect API specifications directly from YAML.</p><p>Paste a specification to browse its endpoints, HTTP methods, parameters, request bodies, responses, schemas, and servers. The API Explorer is read-only and does not send or test requests.</p></article><aside class="content-card"><h2>Related tools</h2><div class="mt-3 space-y-2 text-sm"><a class="related-link" href="/tools/json-formatter/"><span>JSON Formatter</span><span>→</span></a><a class="related-link" href="/tools/json-builder/"><span>JSON Builder</span><span>→</span></a><a class="related-link" href="/tools/diff-checker/"><span>Diff Checker</span><span>→</span></a></div></aside></section>
	</section>
	<script src="../../scripts/yaml-viewer.ts"></script>
</BaseLayout>
<style>
	.yaml-page{max-width:1580px}.workspace{grid-template-columns:45% 55%}.workspace[data-api="true"]{grid-template-columns:33% 67%}.workspace[data-yaml-hidden="true"]{grid-template-columns:0 100%}.workspace[data-yaml-hidden="true"] #yaml-panel{visibility:hidden;overflow:hidden;border:0}.toolbar-button{border-radius:.45rem;padding:.35rem .55rem;font-size:.75rem;font-weight:650;color:rgb(71 85 105)}.toolbar-button:hover{background:rgb(241 245 249);color:rgb(15 23 42)}.control{border:1px solid rgb(203 213 225);border-radius:.55rem;background:transparent;padding:.5rem .7rem;font-size:.875rem;outline:none}.control:focus{border-color:#3b82f6;box-shadow:0 0 0 3px rgb(219 234 254)}.tab,.section-tab,.detail-tab{border-radius:.5rem;padding:.45rem .7rem;font-size:.8rem;font-weight:700}.tab[aria-selected="true"],.section-tab[aria-selected="true"],.detail-tab[aria-selected="true"]{background:#2563eb;color:white}.method{display:inline-block;min-width:3.9rem;border:1px solid currentColor;border-radius:.35rem;padding:.13rem .32rem;text-align:center;font:750 .68rem ui-monospace,monospace}.method-GET{color:#047857}.method-POST{color:#1d4ed8}.method-PUT,.method-PATCH{color:#a16207}.method-DELETE{color:#b91c1c}.method-OPTIONS,.method-HEAD,.method-TRACE{color:#6d28d9}.explorer-columns{grid-template-columns:36% 64%}.schema-columns{grid-template-columns:32% 68%}.explorer-scroll{max-height:calc(100vh - 270px);min-height:430px;scrollbar-gutter:stable}.endpoint-row[aria-current="true"]{background:rgb(239 246 255);box-shadow:inset 3px 0 #2563eb}.endpoint-row:focus-visible,.schema-row:focus-visible{position:relative;z-index:1;outline:2px solid #2563eb;outline-offset:-2px}.detail-section{border-top:1px solid rgb(226 232 240);padding-top:1rem;margin-top:1rem}:global(.dark) .toolbar-button{color:rgb(203 213 225)}:global(.dark) .toolbar-button:hover{background:rgb(30 41 59);color:white}:global(.dark) .control{border-color:rgb(71 85 105)}:global(.dark) .control:focus{box-shadow:0 0 0 3px rgb(30 58 138)}:global(.dark) .endpoint-row[aria-current="true"]{background:rgb(23 37 84);box-shadow:inset 3px 0 #60a5fa}:global(.dark) .detail-section{border-color:rgb(51 65 85)}:global(#tree details){margin-left:1rem}:global(#tree summary){cursor:pointer;padding:.15rem}
	.secondary-action{display:inline-flex;min-height:36px;align-items:center;border:1px solid rgb(203 213 225);border-radius:.5rem;padding:.4rem .7rem;font-size:.78rem;font-weight:700;color:rgb(51 65 85);background:white}.secondary-action:hover{border-color:rgb(148 163 184);background:rgb(248 250 252)}.utility-button,.clear-action{display:inline-flex;min-height:32px;align-items:center;border:1px solid rgb(203 213 225);border-radius:.45rem;padding:.3rem .55rem;font-size:.75rem;font-weight:650;color:rgb(71 85 105);background:white}.utility-button.hidden{display:none}.utility-button:hover{border-color:rgb(96 165 250);background:rgb(241 245 249);color:rgb(30 64 175)}.clear-action{border-color:rgb(254 202 202);color:rgb(185 28 28)}.clear-action:hover{border-color:rgb(252 165 165);background:rgb(254 242 242)}.view-segment{display:grid;grid-template-columns:1fr 1fr;overflow:hidden;border:1px solid rgb(203 213 225);border-radius:.6rem;background:rgb(248 250 252)}.view-segment .tab{min-height:36px;border-radius:0;padding:.45rem .85rem;color:rgb(71 85 105)}.view-segment .tab+ .tab{border-left:1px solid rgb(203 213 225)}.view-segment .tab[aria-selected="true"]{background:#2563eb;color:white;box-shadow:inset 0 0 0 1px #1d4ed8}.section-tabs{display:flex;gap:1rem}.section-tab{border-bottom:2px solid transparent;border-radius:0;padding:.45rem .2rem;color:rgb(100 116 139)}.section-tab[aria-selected="true"]{background:transparent;color:#1d4ed8;border-bottom-color:#2563eb}.filter-chip{flex:none;min-height:32px;border:1px solid rgb(203 213 225);border-radius:999px;padding:.25rem .65rem;font-size:.72rem;font-weight:750;color:rgb(71 85 105);background:white}.filter-chip:hover{border-color:rgb(96 165 250);background:rgb(239 246 255)}.filter-chip[aria-pressed="true"]{border-color:#2563eb;background:#2563eb;color:white}.endpoint-row{cursor:pointer}.endpoint-row:hover{box-shadow:inset 3px 0 rgb(147 197 253)}.endpoint-utility{min-height:32px;border:1px solid rgb(203 213 225);border-radius:.45rem;padding:.3rem .55rem;font-size:.72rem;font-weight:700;color:rgb(71 85 105)}.endpoint-utility:hover{border-color:rgb(96 165 250);background:rgb(239 246 255);color:rgb(30 64 175)}.secondary-action:focus-visible,.utility-button:focus-visible,.clear-action:focus-visible,.tab:focus-visible,.section-tab:focus-visible,.filter-chip:focus-visible,.endpoint-utility:focus-visible{outline:3px solid rgb(147 197 253);outline-offset:2px}
	:global(.dark) .secondary-action{border-color:rgb(71 85 105);background:rgb(15 23 42);color:rgb(226 232 240)}:global(.dark) .secondary-action:hover{border-color:rgb(100 116 139);background:rgb(30 41 59)}:global(.dark) .utility-button{border-color:rgb(71 85 105);background:rgb(15 23 42);color:rgb(203 213 225)}:global(.dark) .utility-button:hover{border-color:rgb(96 165 250);background:rgb(30 41 59);color:rgb(147 197 253)}:global(.dark) .clear-action{border-color:rgb(127 29 29);background:rgb(15 23 42);color:rgb(252 165 165)}:global(.dark) .clear-action:hover{border-color:rgb(185 28 28);background:rgb(69 10 10)}:global(.dark) .view-segment{border-color:rgb(71 85 105);background:rgb(15 23 42)}:global(.dark) .view-segment .tab{color:rgb(203 213 225)}:global(.dark) .view-segment .tab[aria-selected="true"]{color:white}:global(.dark) .view-segment .tab+ .tab{border-color:rgb(71 85 105)}:global(.dark) .section-tab{color:rgb(148 163 184)}:global(.dark) .section-tab[aria-selected="true"]{color:rgb(147 197 253);border-bottom-color:rgb(96 165 250)}:global(.dark) .filter-chip{border-color:rgb(71 85 105);background:rgb(15 23 42);color:rgb(203 213 225)}:global(.dark) .filter-chip:hover{background:rgb(30 41 59)}:global(.dark) .filter-chip[aria-pressed="true"]{border-color:rgb(96 165 250);background:rgb(30 64 175);color:white}:global(.dark) .endpoint-utility{border-color:rgb(71 85 105);color:rgb(203 213 225)}:global(.dark) .endpoint-utility:hover{background:rgb(30 41 59);color:rgb(147 197 253)}
	@media(max-width:1023px){.workspace,.workspace[data-api="true"],.workspace[data-yaml-hidden="true"]{grid-template-columns:1fr}.workspace[data-yaml-hidden="true"] #yaml-panel{display:none}.explorer-columns,.schema-columns{grid-template-columns:1fr}.explorer-scroll{max-height:520px;min-height:260px}.view-segment{width:100%}#toggle-yaml{margin-left:0}.filter-strip{width:100%}}
</style>
