---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = 'Regex Tester Online - Test Regular Expressions | YBS';
const pageDescription = 'Test regular expressions online, highlight matches, inspect capture groups, and preview replacements. Your regex and text stay in your browser.';
const faqs = [
	{ question: 'What is a regular expression?', answer: 'A regular expression is a pattern used to find, extract, or replace text with rules rather than an exact phrase.' },
	{ question: 'Which regex engine does YBS use?', answer: 'This tester uses your browser’s native JavaScript RegExp engine. Syntax and behavior can differ from PCRE, Python, Java, .NET, and other engines.' },
	{ question: 'Does the Regex Tester support capture groups?', answer: 'Yes. Selected-match details show the full match and every numbered capture group, including groups that did not participate.' },
	{ question: 'Does it support named capture groups?', answer: 'Yes, when named groups are supported by your browser’s JavaScript engine.' },
	{ question: 'Can I replace text using regex?', answer: 'Yes. Replace mode previews native JavaScript replacement syntax such as $&, $1, $2, and $<name> without changing the original text.' },
	{ question: 'What do regex flags mean?', answer: 'Flags change matching behavior: g finds all matches, i ignores case, m changes line anchors, s lets dot match newlines, u enables Unicode mode, and y enables sticky matching.' },
	{ question: 'Is my test text uploaded?', answer: 'No. The pattern, test text, matching, and replacement preview remain in your browser.' },
	{ question: 'Why does my regex work differently in another programming language?', answer: 'Regular-expression engines support different syntax and semantics. This tool follows JavaScript RegExp behavior specifically.' },
];
const appSchema = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'YBS Regex Tester', applicationCategory: 'DeveloperApplication', operatingSystem: 'Any', description: pageDescription, ...(Astro.site ? { url: new URL('/tools/regex-tester/', Astro.site).href } : {}), offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } };
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
---
<BaseLayout title={pageTitle} description={pageDescription} canonicalPath="/tools/regex-tester/">
	<Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(appSchema)} /><script type="application/ld+json" set:html={JSON.stringify(faqSchema)} /></Fragment>
	<section class="page-container py-8 sm:py-10">
		<nav class="mb-4 text-sm text-slate-500 dark:text-slate-400" aria-label="Breadcrumb"><a href="/" class="hover:text-blue-600">Home</a><span class="mx-2">/</span><span>Regex Tester</span></nav>
		<header class="mb-6"><p class="eyebrow">Developer tool</p><h1 class="mt-1 text-3xl font-extrabold tracking-tight text-slate-950 dark:text-white sm:text-4xl">Online Regex Tester</h1><p class="mt-2 max-w-3xl text-slate-600 dark:text-slate-300">Test regular expressions, highlight matches, inspect capture groups, and preview replacements directly in your browser.</p></header>

		<div class="regex-workspace overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
			<section class="border-b border-slate-200 p-4 dark:border-slate-700" aria-labelledby="pattern-heading">
				<div class="flex flex-wrap items-center justify-between gap-3"><h2 id="pattern-heading" class="text-sm font-bold">Regular Expression</h2><div class="mode-tabs" role="tablist" aria-label="Regex mode"><button id="test-mode" class="mode-tab" role="tab" aria-selected="true" type="button">Test</button><button id="replace-mode" class="mode-tab" role="tab" aria-selected="false" type="button">Replace</button></div></div>
				<div class="mt-3 flex min-w-0 items-center rounded-xl border border-slate-300 bg-slate-50 px-3 font-mono focus-within:border-blue-500 focus-within:ring-4 focus-within:ring-blue-100 dark:border-slate-600 dark:bg-slate-950 dark:focus-within:ring-blue-900"><span class="text-slate-400">/</span><label class="sr-only" for="regex-pattern">Regular expression pattern</label><input id="regex-pattern" class="min-w-0 flex-1 bg-transparent px-2 py-3 text-sm outline-none" placeholder="Enter a pattern without slash delimiters" spellcheck="false" /><span class="text-slate-400">/</span><output id="inline-flags" class="ml-1 text-blue-600 dark:text-blue-400">g</output></div>
				<div class="mt-3 flex flex-wrap items-center gap-2" aria-label="Regular expression flags">{[
					['g','Global','Find all matches'],['i','Ignore case','Ignore letter case'],['m','Multiline','^ and $ work per line'],['s','Dot all','. matches newlines'],['u','Unicode','Unicode mode'],['y','Sticky','Match at the current position'],
				].map(([flag,label,help]) => <label class="flag-chip" title={`${flag} — ${help}`}><input class="sr-only" type="checkbox" data-flag={flag} checked={flag === 'g'} /><span class="font-mono font-black">{flag}</span><span>{label}</span></label>)}</div>
				<div class="mt-3 flex flex-wrap items-center gap-2"><output id="effective-regex" class="min-w-0 flex-1 overflow-x-auto rounded-lg bg-slate-100 px-3 py-2 font-mono text-xs dark:bg-slate-800">//g</output><button id="copy-regex" class="button-secondary" type="button">Copy Regex</button><label for="example-select" class="sr-only">Regex example</label><select id="example-select" class="control"><option value="">Examples…</option><option value="email">Email-like text</option><option value="url">URL-like text</option><option value="numbers">Numbers</option><option value="date">Dates</option><option value="hashtag">Hashtags</option><option value="whitespace">Whitespace</option><option value="repeated">Repeated words</option></select></div>
				<div id="regex-error" class="mt-3 hidden rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-200" role="alert"></div>
			</section>

			<div class="grid lg:grid-cols-[minmax(0,1.15fr)_minmax(340px,.85fr)]">
				<section class="min-w-0 border-b border-slate-200 dark:border-slate-700 lg:border-b-0 lg:border-r" aria-labelledby="text-heading"><div class="flex items-center justify-between border-b border-slate-200 px-4 py-3 dark:border-slate-700"><h2 id="text-heading" class="text-sm font-bold">Test Text</h2><span id="text-count" class="text-xs text-slate-500">0 / 1,048,576 characters</span></div><label class="sr-only" for="test-text">Text to test against the regular expression</label><textarea id="test-text" class="block min-h-[300px] w-full resize-y bg-white p-4 font-mono text-sm leading-6 outline-none focus:ring-4 focus:ring-inset focus:ring-blue-100 dark:bg-slate-900 dark:text-slate-100 dark:focus:ring-blue-900" placeholder="Paste or type test text here…" spellcheck="false"></textarea><div class="border-t border-slate-200 p-4 dark:border-slate-700"><div class="mb-2 flex flex-wrap items-center justify-between gap-2"><h3 class="text-xs font-bold uppercase tracking-wide text-slate-500">Match Preview</h3><div id="match-nav" class="hidden items-center gap-2"><button id="previous-match" class="utility-button" type="button">Previous</button><span id="match-position" class="min-w-14 text-center text-xs"></span><button id="next-match" class="utility-button" type="button">Next</button></div></div><div id="highlight-preview" class="preview min-h-40 whitespace-pre-wrap break-words rounded-xl border border-slate-200 bg-slate-50 p-4 font-mono text-sm leading-6 dark:border-slate-700 dark:bg-slate-950" tabindex="0">Matches will be highlighted here.</div></div></section>
				<section class="flex min-w-0 flex-col" aria-labelledby="results-heading"><div class="border-b border-slate-200 px-4 py-3 dark:border-slate-700"><div class="flex items-center justify-between"><h2 id="results-heading" class="text-sm font-bold">Match Results</h2><span id="match-count" class="rounded-full bg-blue-50 px-2 py-1 text-xs font-bold text-blue-700 dark:bg-blue-950 dark:text-blue-200">0</span></div><p id="stats" class="mt-1 text-xs text-slate-500">0 Matches · 0 Groups · 0 Characters</p></div><div id="result-empty" class="grid min-h-64 flex-1 place-items-center p-6 text-center text-sm text-slate-500"><div><p class="font-semibold text-slate-700 dark:text-slate-200">Enter a regular expression and some test text to see matches.</p><button id="try-example" class="button-secondary mt-3" type="button">Try an example</button></div></div><div id="result-content" class="hidden min-h-0 flex-1 grid-rows-[auto_1fr]"><div id="match-list" class="max-h-48 overflow-auto border-b border-slate-200 p-2 dark:border-slate-700" aria-label="Matches"></div><article id="match-detail" class="max-h-[420px] overflow-auto p-4" tabindex="0"></article></div></section>
			</div>

			<section id="replacement-panel" class="hidden border-t border-slate-200 p-4 dark:border-slate-700" aria-labelledby="replacement-heading"><div class="grid gap-4 lg:grid-cols-2"><div><label id="replacement-heading" for="replacement" class="text-sm font-bold">Replacement</label><input id="replacement" class="control mt-2 w-full font-mono" placeholder="Use $&, $1, $2, or $<name>" spellcheck="false" /><p class="mt-2 text-xs text-slate-500">Uses native JavaScript replacement syntax.</p></div><div><div class="flex items-center justify-between gap-2"><h3 class="text-sm font-bold">Replacement Preview</h3><button id="copy-replacement" class="button-secondary" type="button">Copy Result</button></div><pre id="replacement-preview" class="mt-2 max-h-52 min-h-24 overflow-auto whitespace-pre-wrap break-words rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm dark:border-slate-700 dark:bg-slate-950"></pre></div></div></section>
			<p class="border-t border-slate-200 bg-blue-50 px-4 py-3 text-sm text-blue-900 dark:border-slate-700 dark:bg-blue-950 dark:text-blue-200"><strong>Private:</strong> Your regex and test text stay in your browser. Inputs are limited to 1 MiB; pathological patterns can still be expensive in JavaScript.</p>
		</div>

		<div class="mt-10 grid gap-6 lg:grid-cols-[2fr_1fr]"><div class="space-y-6"><article class="content-card"><h2>What is a Regex Tester?</h2><p>A regex tester evaluates regular-expression patterns against sample text so developers can inspect matches, positions, and capture groups before using a pattern in code.</p></article><article class="content-card"><h2>How to Test a Regular Expression</h2><ol><li><strong>1.</strong> Enter a pattern without slash delimiters.</li><li><strong>2.</strong> Choose JavaScript flags and paste test text.</li><li><strong>3.</strong> Select a match to inspect numbered and named groups.</li><li><strong>4.</strong> Open Replace mode to preview a replacement without overwriting the source.</li></ol></article><article class="content-card"><h2>Regex Flags</h2><p>This tester supports g (global), i (ignore case), m (multiline), s (dotAll), u (Unicode), and y (sticky), subject to support in your browser.</p></article><article class="content-card"><h2>Capture Groups</h2><p>Parentheses create numbered groups, while syntax such as <code>(?&lt;name&gt;...)</code> creates named groups. Optional groups that do not participate are shown as “Not matched.”</p></article><article class="content-card"><h2>Find and Replace with Regex</h2><p>Replace mode uses JavaScript’s native replacement behavior, including full-match, numbered-group, and named-group tokens.</p></article><article class="content-card"><h2>JavaScript Regex Behavior</h2><p>YBS uses the browser’s JavaScript RegExp engine. Patterns may behave differently in PCRE, Python, Java, .NET, and other engines.</p></article><article class="content-card"><h2>Privacy</h2><p>Pattern evaluation, highlighting, capture-group inspection, and replacement previews run locally. The tool does not upload regex or test text.</p></article></div><div class="space-y-6"><aside class="content-card"><h2>Frequently asked questions</h2><div class="mt-2 divide-y divide-slate-200 dark:divide-slate-700">{faqs.map((faq) => <details class="py-4"><summary class="cursor-pointer text-sm font-semibold">{faq.question}</summary><p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{faq.answer}</p></details>)}</div></aside><aside class="content-card"><h2>Related tools</h2><div class="mt-3 space-y-2 text-sm"><a class="related-link" href="/tools/diff-checker/"><span>Diff Checker</span><span>→</span></a><a class="related-link" href="/tools/json-formatter/"><span>JSON Formatter</span><span>→</span></a><a class="related-link" href="/tools/yaml-viewer/"><span>YAML Viewer &amp; API Explorer</span><span>→</span></a><a class="related-link" href="/tools/character-counter/"><span>Character Counter</span><span>→</span></a></div></aside></div></div>
	</section>
	<script src="../../scripts/regex-tester.ts"></script>
</BaseLayout>
<style>
	.mode-tabs{display:grid;grid-template-columns:1fr 1fr;overflow:hidden;border:1px solid rgb(203 213 225);border-radius:.55rem}.mode-tab{min-height:36px;padding:.4rem .8rem;font-size:.8rem;font-weight:700}.mode-tab+ .mode-tab{border-left:1px solid rgb(203 213 225)}.mode-tab[aria-selected="true"]{background:#2563eb;color:white}.flag-chip{display:inline-flex;min-height:34px;cursor:pointer;align-items:center;gap:.4rem;border:1px solid rgb(203 213 225);border-radius:999px;padding:.3rem .65rem;font-size:.72rem;color:rgb(71 85 105)}.flag-chip:has(input:checked){border-color:#2563eb;background:#eff6ff;color:#1d4ed8;box-shadow:inset 0 0 0 1px #2563eb}.flag-chip:focus-within{outline:3px solid rgb(147 197 253);outline-offset:2px}.control{min-height:38px;border:1px solid rgb(203 213 225);border-radius:.55rem;background:white;padding:.5rem .7rem;font-size:.85rem;outline:none}.control:focus{border-color:#3b82f6;box-shadow:0 0 0 3px rgb(219 234 254)}.utility-button{min-height:34px;border:1px solid rgb(203 213 225);border-radius:.5rem;padding:.35rem .65rem;font-size:.75rem;font-weight:700}.utility-button:hover{border-color:#60a5fa;background:#eff6ff}.match-row{display:flex;width:100%;cursor:pointer;gap:.75rem;border-radius:.5rem;padding:.55rem .65rem;text-align:left;font-size:.78rem}.match-row:hover{background:#f1f5f9}.match-row[aria-selected="true"]{background:#eff6ff;box-shadow:inset 3px 0 #2563eb}.match-highlight{border:1px solid #f59e0b;border-radius:.2rem;background:#fef3c7;padding:0 .08rem;color:#78350f}.match-highlight[data-selected="true"]{outline:2px solid #2563eb;outline-offset:1px}.preview{overflow-wrap:anywhere}.detail-block{border-top:1px solid rgb(226 232 240);padding-top:.8rem;margin-top:.8rem}:global(.dark) .mode-tabs,:global(.dark) .mode-tab+ .mode-tab,:global(.dark) .flag-chip,:global(.dark) .control,:global(.dark) .utility-button{border-color:rgb(71 85 105)}:global(.dark) .flag-chip{color:rgb(203 213 225)}:global(.dark) .flag-chip:has(input:checked){border-color:#60a5fa;background:#172554;color:#bfdbfe}:global(.dark) .control{background:rgb(2 6 23)}:global(.dark) .match-row:hover{background:#1e293b}:global(.dark) .match-row[aria-selected="true"]{background:#172554;box-shadow:inset 3px 0 #60a5fa}:global(.dark) .match-highlight{border-color:#fbbf24;background:#713f12;color:#fef3c7}:global(.dark) .match-highlight[data-selected="true"]{outline-color:#60a5fa}:global(.dark) .detail-block{border-color:rgb(51 65 85)}
</style>
