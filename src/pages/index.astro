---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';

const tools = [
	{ name: 'Word Counter', description: 'Count words, characters, sentences, and reading time instantly.', href: '/tools/word-counter', icon: 'Aa', available: true, category: 'Text' },
	{ name: 'Character Counter', description: 'Measure character length with and without spaces.', href: '/tools/character-counter', icon: '#', available: true, category: 'Text' },
	{ name: 'JSON Formatter', description: 'Format and validate JSON for easier reading.', icon: '{}', category: 'Developer' },
	{ name: 'Password Generator', description: 'Create strong, secure passwords in seconds.', icon: '⌁', category: 'Security' },
	{ name: 'QR Code Generator', description: 'Turn links and text into scannable QR codes.', icon: '▦', category: 'Utility' },
	{ name: 'Age Calculator', description: 'Calculate an exact age from any birth date.', icon: '◷', category: 'Calculator' },
];

const categories = [
	{ name: 'Text Tools', detail: 'Count, format, and improve text.', icon: 'T', count: '2 tools' },
	{ name: 'Developer Tools', detail: 'Utilities for cleaner workflows.', icon: '</>', count: '1 tool' },
	{ name: 'Generators', detail: 'Create useful outputs instantly.', icon: '✦', count: '2 tools' },
	{ name: 'Calculators', detail: 'Fast answers for daily questions.', icon: '=', count: '1 tool' },
];
---

<BaseLayout title="ToolPulse — Free Online Tools" description="Free online tools for text, development, security, calculations, and everyday tasks.">
	<section class="border-b border-slate-200 bg-white">
		<div class="page-container py-12 text-center sm:py-16">
			<span class="inline-flex rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700">Fast, private, and free</span>
			<h1 class="mx-auto mt-4 max-w-3xl text-3xl font-extrabold tracking-tight text-slate-950 sm:text-5xl">
				Free online tools for everyday tasks
			</h1>
			<p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-slate-600 sm:text-lg">
				Simple utilities that work right in your browser. No accounts, no downloads, no clutter.
			</p>
			<div class="relative mx-auto mt-7 max-w-xl">
				<svg class="pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
					<path d="m16 16 4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
				</svg>
				<label for="tool-search" class="sr-only">Search tools</label>
				<input id="tool-search" type="search" placeholder="Search tools..." class="w-full rounded-xl border border-slate-300 bg-white py-3.5 pl-12 pr-4 text-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-100" />
			</div>
		</div>
	</section>

	<section id="tools" class="page-container scroll-mt-20 py-12">
		<div class="section-heading">
			<div>
				<p class="eyebrow">Useful right now</p>
				<h2>Popular tools</h2>
			</div>
			<p>Quick, focused utilities for the tasks you do most.</p>
		</div>
		<div id="tool-grid" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{tools.map((tool) => <ToolCard {...tool} />)}
		</div>
		<p id="no-results" class="mt-8 hidden rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500">No tools match your search.</p>
	</section>

	<section id="categories" class="scroll-mt-20 border-y border-slate-200 bg-white">
		<div class="page-container py-12">
			<div class="section-heading">
				<div>
					<p class="eyebrow">Browse by type</p>
					<h2>Categories</h2>
				</div>
				<p>Find the right utility without digging through menus.</p>
			</div>
			<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
				{categories.map((category) => (
					<div class="rounded-2xl border border-slate-200 p-5">
						<div class="flex items-center gap-3">
							<span class="grid size-10 place-items-center rounded-xl bg-slate-100 text-sm font-bold text-blue-600">{category.icon}</span>
							<div>
								<h3 class="font-bold">{category.name}</h3>
								<span class="text-xs text-slate-400">{category.count}</span>
							</div>
						</div>
						<p class="mt-3 text-sm leading-6 text-slate-600">{category.detail}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="page-container py-12">
		<div class="rounded-2xl bg-slate-900 px-6 py-8 text-white sm:px-8">
			<div class="grid gap-7 md:grid-cols-[1fr_2fr] md:items-center">
				<div>
					<p class="text-xs font-bold uppercase tracking-widest text-blue-300">Why ToolPulse?</p>
					<h2 class="mt-2 text-2xl font-bold">Tools that respect your time.</h2>
				</div>
				<div class="grid gap-5 sm:grid-cols-3">
					<div><strong class="block text-sm">Instant results</strong><span class="mt-1 block text-sm text-slate-300">No waiting or setup.</span></div>
					<div><strong class="block text-sm">Browser based</strong><span class="mt-1 block text-sm text-slate-300">Your work stays local.</span></div>
					<div><strong class="block text-sm">Always free</strong><span class="mt-1 block text-sm text-slate-300">No signup required.</span></div>
				</div>
			</div>
		</div>
	</section>

	<script>
		const search = document.querySelector<HTMLInputElement>('#tool-search');
		const cards = [...document.querySelectorAll<HTMLElement>('[data-tool-card]')];
		const emptyState = document.querySelector<HTMLElement>('#no-results');

		search?.addEventListener('input', () => {
			const query = search.value.trim().toLowerCase();
			let matches = 0;
			cards.forEach((card) => {
				const visible = (card.dataset.search ?? '').includes(query);
				card.classList.toggle('hidden', !visible);
				if (visible) matches++;
			});
			emptyState?.classList.toggle('hidden', matches > 0);
		});
	</script>
</BaseLayout>
