---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import SearchBar from '../components/home/SearchBar.astro';
import CategoryFilters from '../components/home/CategoryFilters.astro';
import FeaturedTools from '../components/home/FeaturedTools.astro';
import { availableTools } from '../data/tools';
import { SEO } from '../config/brand';

const filters = [
	{ name: 'Developer', icon: '</>' }, { name: 'JSON', icon: '{}' },
	{ name: 'Text', icon: 'Aa' }, { name: 'Image', icon: '▧' },
	{ name: 'PDF', icon: '▤' }, { name: 'Converters', icon: '⇄' },
	{ name: 'Security', icon: '◇' },
	{ name: 'Fun', icon: '✦' },
] as const;
const categories = filters.map((category) => ({ ...category, count: availableTools.filter((tool) => tool.tags.some((tag) => tag.toLowerCase() === category.name.toLowerCase())).length }));
const popularOrder = ['diff-checker', 'json-formatter', 'json-builder', 'base64-encoder', 'word-counter', 'character-counter', 'windows-update-simulator'];
const popularTools = [...availableTools].sort((a, b) => popularOrder.indexOf(a.slug) - popularOrder.indexOf(b.slug));
---

<BaseLayout title={SEO.defaultTitle} description={SEO.defaultDescription} canonicalPath="/">
	<div class="bg-white">
		<Hero />
		<section class="border-b border-slate-100 bg-white py-3 dark:bg-[#0b1120] sm:py-4" aria-label="Find a tool">
			<div class="page-container">
				<div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-2.5 shadow-sm dark:border-[#273449] dark:bg-[#0f172a] dark:shadow-[0_16px_40px_rgba(0,0,0,.16)] sm:p-3">
					<SearchBar tools={availableTools} />
					<CategoryFilters categories={categories} total={availableTools.length} />
				</div>
			</div>
		</section>
		<FeaturedTools tools={popularTools} />
	</div>

	<script>
		const search = document.querySelector<HTMLInputElement>('#tool-search');
		const cards = [...document.querySelectorAll<HTMLElement>('[data-tool-card]')];
		const categoryButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-category]')];
		const suggestions = [...document.querySelectorAll<HTMLElement>('[data-suggestion]')];
		const suggestionsPanel = document.querySelector<HTMLElement>('#search-suggestions');
		const noSuggestions = document.querySelector<HTMLElement>('#no-suggestions');
		const clearSearch = document.querySelector<HTMLButtonElement>('#clear-search');
		const shortcutHint = document.querySelector<HTMLElement>('#search-shortcut');
		const searchArea = document.querySelector<HTMLElement>('#search-area');
		const searchLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-search-link]')];
		const emptyState = document.querySelector<HTMLElement>('#no-results');
		const visibleCount = document.querySelector<HTMLElement>('#search-result-count');
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let activeCategory = '';

		const queryMatches = (value: string, query: string) => query.split(/\s+/u).filter(Boolean).every((token) => value.includes(token));
		function setActiveCategory(category: string) {
			activeCategory = category;
			categoryButtons.forEach((item) => { const selected = (item.dataset.category ?? '') === category; item.classList.toggle('home-category-active', selected); item.setAttribute('aria-pressed', String(selected)); });
		}
		function filterTools(showSuggestions = false) {
			const query = search?.value.trim().toLowerCase() ?? '';
			let matches = 0;
			cards.forEach((card) => { const visible = queryMatches(card.dataset.search ?? '', query) && (!activeCategory || (card.dataset.categories ?? '').split(' ').includes(activeCategory)); card.classList.toggle('hidden', !visible); if (visible) matches++; });
			let suggestionMatches = 0;
			suggestions.forEach((suggestion) => { const visible = queryMatches(suggestion.dataset.search ?? '', query) && (!activeCategory || (suggestion.dataset.categories ?? '').split(' ').includes(activeCategory)); suggestion.classList.toggle('hidden', !visible); if (visible) suggestionMatches++; });
			noSuggestions?.classList.toggle('hidden', suggestionMatches > 0);
			suggestionsPanel?.classList.toggle('hidden', !showSuggestions);
			search?.setAttribute('aria-expanded', String(showSuggestions));
			if (clearSearch) clearSearch.hidden = !query;
			shortcutHint?.classList.toggle('invisible', Boolean(query));
			emptyState?.classList.toggle('hidden', matches > 0);
			if (visibleCount) visibleCount.textContent = matches === 1 ? '1 tool found' : `${matches} tools found`;
		}
		function openSearch() { search?.focus(); search?.select(); filterTools(true); searchArea?.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'center' }); }
		search?.addEventListener('focus', () => filterTools(true));
		search?.addEventListener('input', () => filterTools(true));
		search?.addEventListener('keydown', (event) => { if (event.key !== 'Escape') return; if (search.value) { search.value = ''; filterTools(true); } else { suggestionsPanel?.classList.add('hidden'); search.setAttribute('aria-expanded', 'false'); search.blur(); } });
		clearSearch?.addEventListener('click', () => { if (search) search.value = ''; filterTools(true); search?.focus(); });
		searchLinks.forEach((link) => link.addEventListener('click', (event) => { event.preventDefault(); openSearch(); }));
		document.addEventListener('keydown', (event) => { const target = event.target as HTMLElement; if (event.key === '/' && !['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName) && !target.isContentEditable) { event.preventDefault(); openSearch(); } });
		document.addEventListener('click', (event) => { if (!searchArea?.contains(event.target as Node) && !(event.target as Element).closest?.('[data-search-link]')) { suggestionsPanel?.classList.add('hidden'); search?.setAttribute('aria-expanded', 'false'); } });
		categoryButtons.forEach((button) => button.addEventListener('click', () => { setActiveCategory(button.dataset.category ?? ''); filterTools(false); document.querySelector('#tools')?.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'start' }); }));
		if (window.location.hash === '#tool-search') window.requestAnimationFrame(openSearch);
	</script>
</BaseLayout>
