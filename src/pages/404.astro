---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
---

<BaseLayout title="Page Not Found | YBS" description="The requested YBS page could not be found.">
	<section class="page-container py-20 text-center sm:py-28">
		<Logo class="justify-center" />
		<p class="eyebrow mt-8">404 error</p>
		<h1 class="mt-2 text-4xl font-extrabold tracking-tight text-slate-950 dark:text-white">Page not found</h1>
		<p class="mx-auto mt-3 max-w-md text-slate-600 dark:text-slate-300">The page you requested does not exist or may have moved.</p>
		<a href="/" class="button-primary mt-7">Explore Tools</a>
	</section>
</BaseLayout>
